# ==============================================================================
# KLIR OS - Environment Configuration Template
# ==============================================================================

# 1. Server & Environment
PORT=3000
NODE_ENV=development

# 2. Database Configuration
#
# PILIHAN A — PostgreSQL lokal di container Docker (disarankan untuk pengembangan)
#   docker compose up -d
#   npx prisma db push
# Port host 5434 karena 5432 dan 5433 sering sudah dipakai container proyek lain.
DATABASE_URL="postgresql://klir:klir_local@localhost:5434/klir?schema=public"
DIRECT_URL="postgresql://klir:klir_local@localhost:5434/klir?schema=public"
#
# PILIHAN B — Neon Serverless Postgres (produksi)
# DATABASE_URL: Pooled Connection String (digunakan Prisma Client via PgBouncer)
# DATABASE_URL="postgres://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
#
# DIRECT_URL: Direct Connection String (digunakan Prisma Migrations)
# DIRECT_URL="postgres://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# PERINGATAN: `prisma db push` menulis ke database yang ditunjuk DATABASE_URL.
# Pastikan tidak sedang menunjuk produksi saat bereksperimen dengan skema.

# 3. Redis Cache & Queue (Upstash / Local Redis)
REDIS_URL="redis://localhost:6379"

# 4. Authentication & Security (JWT)
JWT_SECRET="super_secret_klir_jwt_key_change_in_production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# 5. AI Provider API Keys (KLIR Multi-Model AI Gateway)
# Google Gemini (Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."

# Groq (GroqCloud Console: https://console.groq.com)
GROQ_API_KEY="gsk_..."

# OpenAI (OpenAI Platform: https://platform.openai.com)
OPENAI_API_KEY="sk-..."

# OpenRouter / OpenCode (OpenRouter Console: https://openrouter.ai)
OPENROUTER_API_KEY="sk-or-v1-..."

# Anthropic Claude (Anthropic Console: https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# 6. Seedance AI Image Generation API
SEEDANCE_API_KEY="your_seedance_api_key_here"
SEEDANCE_API_URL="https://api.seedance.ai/v1/images/generations"

# 7. Google OAuth (Sign in with Google via Google Cloud Console)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"

# 8. Demo Mode Configuration
# Set to 'true' to enable demo mode (bypass authentication for backup system)
# WARNING: Only use for development/demo purposes!
NEXT_PUBLIC_DEMO_MODE="false"
NEXT_PUBLIC_DEMO_WORKSPACE_ID="a1000000-0000-0000-0000-000000000001"
