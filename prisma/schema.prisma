// KLIR Inventory fondasi (9 Sep 2026, BUILD_PLAN smart-dispatch workflow terpisah,
// dilaksanakan agent eksekusi). Alasan: modul Stok/Purchasing UMKM genuinely 0 model
// di schema sebelum ini (dicek full-scan). Murni ADDITIVE -- nol baris existing diubah
// kecuali menambah relasi array di Workspace/User. costPrice di Product = harga beli
// TERAKHIR (cache), histori harga per pembelian ada di StockMovement.unitCost dan
// PurchaseOrderItem.unitCost. currentStock di Product = cache running-balance, sumber
// kebenaran tetap StockMovement (append-only, qtyChange signed). Disinkron pakai
// `prisma db push` (pola sama dgn model lain di file ini) -- TAPI eksekusi db push ke
// database produksi MASIH menunggu izin eksplisit Mecca (lihat 6 pertanyaan
// arsitektural BUILD_PLAN), belum dijalankan oleh agent penulis skema ini.
model Product {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  sourceFileId  String?  @map("source_file_id") @db.Uuid
  sku           String?  @db.VarChar(100)
  name          String   @db.VarChar(255)
  category      String?  @db.VarChar(100)
  unit          String   @default("pcs") @db.VarChar(50)
  // "OWNED" (beli putus, default) atau "CONSIGNED" (titip jual, belum dibayar ke supplier
  // sampai laku). String bebas bukan enum, konsisten pola "unit" di atas.
  ownershipType String   @default("OWNED") @map("ownership_type") @db.VarChar(20)
  costPrice     Float    @default(0) @map("cost_price")
  sellPrice     Float    @default(0) @map("sell_price")
  currentStock  Float    @default(0) @map("current_stock")
  minStock      Float    @default(0) @map("min_stock")
  imageUrl      String?  @map("image_url") @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  // Additive 10 Sep 2026 (Fable) -- kontrak inventory-api-schema, kontrak Distributor
  // F3b/F4. packSize/packUnit = konversi satuan dus/pcs (2026-09-10-scan-kebutuhan-
  // data-modul-7.md bagian 3.1). packSize default 1 supaya produk lama otomatis
  // "1 pack = 1 unit" (perilaku lama tidak berubah). packUnit nullable (kosong = produk
  // tidak pakai konsep pack, dijual satuan langsung). unit (kolom lama di atas) TETAP
  // jadi satuan jual/tampil, maknanya tidak berubah.
  packSize      Int?     @default(1) @map("pack_size")
  packUnit      String?  @map("pack_unit") @db.VarChar(50)
  // Soft-reference (bukan foreign key Prisma) ke SupplierScore.supplierName /
  // PurchaseOrder.supplierName -- meniru pola sourceType/sourceId di StockMovement/
  // StockReturn (match by string, bukan relasi formal). Nullable, dipakai laporan
  // konsinyasi untuk tahu titipan produk ini punya siapa (bagian 3.4 dokumen di atas).
  supplierName  String?  @map("supplier_name") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  stockReturns       StockReturn[]
  batches            ProductBatch[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, sourceFileId])
  @@map("products")
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  OPENING_BALANCE
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  userId      String?           @map("user_id") @db.Uuid
  type        StockMovementType
  // Signed: positif = IN, negatif = OUT. Meniru pola CreditLedger.amount.
  qtyChange   Float             @map("qty_change")
  unitCost    Float?            @map("unit_cost")
  // Soft-reference (bukan relasi Prisma), meniru pola WorkspaceFile.linkedRecordIds --
  // mis. sourceType="purchase_order", sourceId=<PurchaseOrder.id>.
  sourceType  String?           @map("source_type") @db.VarChar(50)
  sourceId    String?           @map("source_id") @db.Uuid
  note        String?
  // Additive 10 Sep 2026 (Fable) -- kontrak inventory-api-schema, F3b/F4. Soft-relasi
  // ke Customer (nullable, opsional) supaya penjualan SALE_OUT bisa dikaitkan ke
  // pembeli terstruktur untuk fitur "restock per toko/wilayah" (Distributor). Ditaruh
  // di StockMovement (bukan CashTransaction) karena rekomendasi restock per-customer
  // butuh GROUP BY dari baris barang KELUAR, bukan sisi kas -- lihat
  // 2026-09-10-scan-kebutuhan-data-modul-7.md bagian 3.3. onDelete SetNull: Customer
  // dihapus tidak menghapus histori StockMovement lama, cuma customerId-nya jadi null.
  customerId  String?           @map("customer_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, productId, createdAt])
  @@index([workspaceId, type])
  @@index([workspaceId, sourceType, sourceId])
  @@index([workspaceId, customerId, createdAt])
  @@map("stock_movements")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @map("workspace_id") @db.Uuid
  userId            String?             @map("user_id") @db.Uuid
  poNumber          String              @map("po_number") @db.VarChar(50)
  supplierName      String              @map("supplier_name") @db.VarChar(150)
  supplierPhone     String?             @map("supplier_phone") @db.VarChar(50)
  status            PurchaseOrderStatus @default(RECEIVED)
  totalAmount       Float               @map("total_amount")
  paymentMethod     String              @default("TUNAI") @map("payment_method") @db.VarChar(50)
  purchaseDate      DateTime            @map("purchase_date")
  notes             String?
  // Soft-link (bukan relasi Prisma) ke CashTransaction -- model CashTransaction tidak
  // disentuh sama sekali.
  cashTransactionId String?             @map("cash_transaction_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]

  @@unique([workspaceId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  qty             Float
  unitCost        Float  @map("unit_cost")
  subtotal        Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_order_items")
}

// Retur stok: barang balik ke supplier (TO_SUPPLIER, mis. rusak/salah kirim) atau
// balik dari pelanggan (FROM_CUSTOMER, mis. komplain/tukar). Additive-only, meniru
// pola soft-reference sourceType/sourceId dan soft-link cashTransactionId di StockMovement.
model StockReturn {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  // String bebas bukan enum, konsisten pola "unit"/"ownershipType" -- "TO_SUPPLIER" atau
  // "FROM_CUSTOMER".
  direction         String   @db.VarChar(20)
  qty               Float
  reason            String?
  // Soft-reference (bukan relasi Prisma), meniru pola StockMovement.sourceType/sourceId.
  sourceType        String?  @map("source_type") @db.VarChar(50)
  sourceId          String?  @map("source_id") @db.Uuid
  // Soft-link (bukan relasi Prisma) ke CashTransaction -- model CashTransaction tidak
  // disentuh sama sekali, meniru pola PurchaseOrder.cashTransactionId.
  cashTransactionId String?  @map("cash_transaction_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([workspaceId, productId, createdAt])
  @@index([workspaceId, direction])
  @@index([workspaceId, sourceType, sourceId])
  @@map("stock_returns")
}

// Skor supplier berdiri sendiri -- TIDAK terhubung ke CompanyHealthScore (breakdown
// 35/30/20/15 HARAM diubah). Dipakai untuk fitur rekomendasi supplier terpisah.
model SupplierScore {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  supplierName     String    @map("supplier_name") @db.VarChar(150)
  score            Float     @default(0)
  onTimeRate       Float?    @map("on_time_rate")
  priceStability   Float?    @map("price_stability")
  defectRate       Float?    @map("defect_rate")
  lastCalculatedAt DateTime? @map("last_calculated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, supplierName])
  @@map("supplier_scores")
}

// Additive 10 Sep 2026 (Fable) -- batch BANGUN gabungan F3b/F4, kontrak
// inventory-api-schema. Skema persis 2026-09-10-scan-kebutuhan-data-modul-7.md
// bagian 3.2. Batch/kadaluarsa DIPISAH dari Product (bukan kolom di Product) karena
// 1 produk bisa punya banyak batch beda tanggal kadaluarsa -- Product.currentStock
// (angka tunggal, cache running-balance lama) TETAP jadi sumber kebenaran utama untuk
// SEMUA fitur lama (restock, dead-stock, turnover currentStock, dsb) - ProductBatch
// HANYA dipakai fitur BARU (alert kadaluarsa, urutan FEFO). qty di sini murni
// pembagian/pencatatan dari stok yang sudah ada di Product.currentStock -- endpoint
// POST batch di kontrak ini SENGAJA TIDAK mengubah Product.currentStock (lihat komentar
// di product-batches/route.ts). Sinkronisasi penuh (StockMovement SALE_OUT ikut
// mengurangi qty batch tertentu secara FEFO) masih didesain terpisah, di luar kontrak ini.
model ProductBatch {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  batchCode   String?  @map("batch_code") @db.VarChar(100)
  expiryDate  DateTime @map("expiry_date")
  qty         Float
  // Soft-link (bukan relasi Prisma), meniru pola StockMovement.sourceType/sourceId.
  sourceType  String?  @map("source_type") @db.VarChar(50)
  sourceId    String?  @map("source_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, productId, expiryDate])
  @@index([workspaceId, expiryDate])
  @@map("product_batches")
}

// Additive 10 Sep 2026 (Fable) -- batch BANGUN gabungan F3b/F4, kontrak
// inventory-api-schema. Skema persis 2026-09-10-scan-kebutuhan-data-modul-7.md
// bagian 3.3 (Distributor: pelanggan/toko + wilayah). area & type sengaja String
// bebas bukan enum, konsisten pola "unit"/"ownershipType"/"direction" di file ini --
// istilah wilayah/jenis pelanggan masih bisa berubah dari hasil survei Distributor
// yang belum selesai. Field customerName teks bebas yang sudah ada di
// sales/route.ts (ditempel ke CashTransaction.description) TIDAK dihapus/diubah --
// tetap ada untuk pembeli lewat/jalan yang belum terdaftar sebagai Customer.
model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(150)
  phone       String?  @db.VarChar(50)
  address     String?
  area        String?  @db.VarChar(100)
  type        String   @default("LAINNYA") @db.VarChar(20)
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([workspaceId, area])
  @@index([workspaceId, name])
  @@map("customers")
}

// ============================================================================
// MODUL LAPORAN KEUANGAN (DOUBLE-ENTRY)
// Additive 19 Okt 2026. Semua nominal uang memakai Decimal(18,2) -- bukan Float --
// supaya penjumlahan tidak terkena pembulatan biner. CashTransaction.amount yang
// lama tetap Float (legacy) dan dikonversi di batas (lihat src/lib/accounting/money.ts).
// Prinsip: seluruh laporan membaca journal_lines, TIDAK PERNAH cash_transactions.
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum CashAccountType {
  CASH
  BANK
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum JournalSource {
  MANUAL
  CASH_TX
  INVOICE
  INVOICE_PAYMENT
  OBLIGATION
  OBLIGATION_PAYMENT
  PAYROLL
  OPENING
  ADJUSTMENT
  CLOSING
  REVERSAL
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum PeriodStatus {
  OPEN
  CLOSING
  CLOSED
  LOCKED
}

enum TaxProfile {
  UMKM_NON_PKP
  UMKM_PKP
  BADAN_NORMAL
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  code          String        @db.VarChar(20)
  name          String        @db.VarChar(150)
  type          AccountType
  normalBalance NormalBalance @map("normal_balance")
  parentId      String?       @map("parent_id") @db.Uuid
  // Akun header (mis. "1-1000 Aset Lancar") tidak boleh dipakai di jurnal.
  isPostable    Boolean       @default(true) @map("is_postable")
  // Akun sistem tidak boleh dihapus karena dipakai logika auto-posting.
  isSystem      Boolean       @default(false) @map("is_system")
  isActive      Boolean       @default(true) @map("is_active")
  description   String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent       Account?             @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Account[]            @relation("AccountTree")
  lines        JournalLine[]
  cashAccounts CashAccount[]
  categoryMaps CategoryAccountMap[]

  @@unique([workspaceId, code])
  @@index([workspaceId, type])
  @@index([workspaceId, parentId])
  @@map("accounts")
}

model CashAccount {
  id            String          @id @default(uuid()) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  code          String          @db.VarChar(20)
  name          String          @db.VarChar(100)
  type          CashAccountType
  // Akun CoA tempat saldo rekening ini dicatat (mis. 1-1110 Kas).
  accountId     String          @map("account_id") @db.Uuid
  bankName      String?         @map("bank_name") @db.VarChar(100)
  accountNumber String?         @map("account_number") @db.VarChar(50)
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lines     JournalLine[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive])
  @@map("cash_accounts")
}

model Partner {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  name        String      @db.VarChar(150)
  type        PartnerType @default(CUSTOMER)
  email       String?     @db.VarChar(255)
  phone       String?     @db.VarChar(50)
  address     String?
  npwp        String?     @db.VarChar(30)
  isActive    Boolean     @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines     JournalLine[]

  @@index([workspaceId, type])
  @@index([workspaceId, name])
  @@map("partners")
}

model FiscalPeriod {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  year        Int
  month       Int
  startDate   DateTime     @map("start_date")
  endDate     DateTime     @map("end_date")
  status      PeriodStatus @default(OPEN)
  closedAt    DateTime?    @map("closed_at")
  closedBy    String?      @map("closed_by") @db.Uuid
  lockedAt    DateTime?    @map("locked_at")
  lockedBy    String?      @map("locked_by") @db.Uuid

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   JournalEntry[]

  @@unique([workspaceId, year, month])
  @@index([workspaceId, status])
  @@map("fiscal_periods")
}

model JournalEntry {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  periodId     String        @map("period_id") @db.Uuid
  entryNumber  String        @map("entry_number") @db.VarChar(30)
  entryDate    DateTime      @map("entry_date")
  description  String
  source       JournalSource
  // Dokumen sumber (CashTransaction.id, Invoice.id, dst). Null untuk MANUAL/OPENING.
  sourceId     String?       @map("source_id") @db.Uuid
  status       JournalStatus @default(DRAFT)
  totalDebit   Decimal       @map("total_debit") @db.Decimal(18, 2)
  totalCredit  Decimal       @map("total_credit") @db.Decimal(18, 2)
  createdBy    String        @map("created_by") @db.Uuid
  postedBy     String?       @map("posted_by") @db.Uuid
  postedAt     DateTime?     @map("posted_at")
  reversalOfId String?       @unique @map("reversal_of_id") @db.Uuid
  reversedBy   String?       @map("reversed_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  period     FiscalPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines      JournalLine[]
  reversalOf JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversed   JournalEntry? @relation("JournalReversal")

  // Cegah jurnal dobel bila dokumen sumber diproses ulang.
  // sourceId NULL (MANUAL/OPENING) boleh berulang -- perilaku default Postgres.
  @@unique([workspaceId, source, sourceId])
  @@unique([workspaceId, entryNumber])
  @@index([workspaceId, entryDate])
  @@index([workspaceId, status])
  @@index([workspaceId, periodId])
  @@map("journal_entries")
}

model JournalLine {
  id            String  @id @default(uuid()) @db.Uuid
  workspaceId   String  @map("workspace_id") @db.Uuid
  entryId       String  @map("entry_id") @db.Uuid
  lineNo        Int     @map("line_no")
  accountId     String  @map("account_id") @db.Uuid
  cashAccountId String? @map("cash_account_id") @db.Uuid
  partnerId     String? @map("partner_id") @db.Uuid
  description   String?
  debit         Decimal @default(0) @db.Decimal(18, 2)
  credit        Decimal @default(0) @db.Decimal(18, 2)
  currency      String  @default("IDR") @db.VarChar(3)
  exchangeRate  Decimal @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  costCenter    String? @map("cost_center") @db.VarChar(50)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  partner     Partner?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@unique([entryId, lineNo])
  @@index([workspaceId, accountId])
  @@index([workspaceId, partnerId])
  @@index([workspaceId, cashAccountId])
  @@map("journal_lines")
}

model AccountingSetting {
  id                         String     @id @default(uuid()) @db.Uuid
  workspaceId                String     @unique @map("workspace_id") @db.Uuid
  isEnabled                  Boolean    @default(false) @map("is_enabled")
  booksStartDate             DateTime?  @map("books_start_date")
  taxProfile                 TaxProfile @default(UMKM_NON_PKP) @map("tax_profile")
  entityType                 String     @default("BADAN_USAHA") @map("entity_type") @db.VarChar(30)
  fiscalYearStartMonth       Int        @default(1) @map("fiscal_year_start_month")
  retainedEarningsAccountId  String?    @map("retained_earnings_account_id") @db.Uuid
  currentYearProfitAccountId String?    @map("current_year_profit_account_id") @db.Uuid
  defaultCashAccountId       String?    @map("default_cash_account_id") @db.Uuid
  // Akun pendapatan yang dipakai saat faktur (AR) diterbitkan. Faktur hanya
  // menyimpan daftar item (nama/harga/qty) tanpa kategori akun, jadi owner
  // memilih SATU akun pendapatan default di Pengaturan.
  defaultRevenueAccountId    String?    @map("default_revenue_account_id") @db.Uuid
  enablePpn                  Boolean    @default(false) @map("enable_ppn")
  enableInventory            Boolean    @default(false) @map("enable_inventory")
  createdAt                  DateTime   @default(now()) @map("created_at")
  updatedAt                  DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("accounting_settings")
}

model CategoryAccountMap {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  category    String      @db.VarChar(100)
  type        AccountType
  accountId   String      @map("account_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, category, type])
  @@map("category_account_maps")
}

model DocumentSequence {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  key         String @db.VarChar(30)
  nextNumber  Int    @default(1) @map("next_number")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("document_sequences")
}
