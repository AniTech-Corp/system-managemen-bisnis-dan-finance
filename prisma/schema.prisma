// KLIR Inventory fondasi (9 Sep 2026, BUILD_PLAN smart-dispatch workflow terpisah,
// dilaksanakan agent eksekusi). Alasan: modul Stok/Purchasing UMKM genuinely 0 model
// di schema sebelum ini (dicek full-scan). Murni ADDITIVE -- nol baris existing diubah
// kecuali menambah relasi array di Workspace/User. costPrice di Product = harga beli
// TERAKHIR (cache), histori harga per pembelian ada di StockMovement.unitCost dan
// PurchaseOrderItem.unitCost. currentStock di Product = cache running-balance, sumber
// kebenaran tetap StockMovement (append-only, qtyChange signed). Disinkron pakai
// `prisma db push` (pola sama dgn model lain di file ini) -- TAPI eksekusi db push ke
// database produksi MASIH menunggu izin eksplisit Mecca (lihat 6 pertanyaan
// arsitektural BUILD_PLAN), belum dijalankan oleh agent penulis skema ini.
model Product {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  sourceFileId   String?  @map("source_file_id") @db.Uuid
  sku            String?  @db.VarChar(100)
  name           String   @db.VarChar(255)
  category       String?  @db.VarChar(100)
  unit           String   @default("pcs") @db.VarChar(50)
  // "OWNED" (beli putus, default) atau "CONSIGNED" (titip jual, belum dibayar ke supplier
  // sampai laku). String bebas bukan enum, konsisten pola "unit" di atas.
  ownershipType  String   @default("OWNED") @map("ownership_type") @db.VarChar(20)
  costPrice      Float    @default(0) @map("cost_price")
  sellPrice      Float    @default(0) @map("sell_price")
  currentStock   Float    @default(0) @map("current_stock")
  // Nilai persediaan menurut buku (rata-rata bergerak) -- SATU-satunya angka
  // yang dipakai laporan "Nilai Persediaan" untuk dicocokkan dengan saldo akun
  // 1-1400. Diperbarui di alur yang sama dengan currentStock supaya nilai buku
  // tidak pernah berbeda dari kartu stok karena pembulatan.
  inventoryValue Float    @default(0) @map("inventory_value")
  minStock       Float    @default(0) @map("min_stock")
  imageUrl       String?  @map("image_url") @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  // Additive 10 Sep 2026 (Fable) -- kontrak inventory-api-schema, kontrak Distributor
  // F3b/F4. packSize/packUnit = konversi satuan dus/pcs (2026-09-10-scan-kebutuhan-
  // data-modul-7.md bagian 3.1). packSize default 1 supaya produk lama otomatis
  // "1 pack = 1 unit" (perilaku lama tidak berubah). packUnit nullable (kosong = produk
  // tidak pakai konsep pack, dijual satuan langsung). unit (kolom lama di atas) TETAP
  // jadi satuan jual/tampil, maknanya tidak berubah.
  packSize       Int?     @default(1) @map("pack_size")
  packUnit       String?  @map("pack_unit") @db.VarChar(50)
  // Soft-reference (bukan foreign key Prisma) ke SupplierScore.supplierName /
  // PurchaseOrder.supplierName -- meniru pola sourceType/sourceId di StockMovement/
  // StockReturn (match by string, bukan relasi formal). Nullable, dipakai laporan
  // konsinyasi untuk tahu titipan produk ini punya siapa (bagian 3.4 dokumen di atas).
  supplierName   String?  @map("supplier_name") @db.VarChar(150)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  stockReturns       StockReturn[]
  batches            ProductBatch[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, sourceFileId])
  @@map("products")
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  OPENING_BALANCE
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  userId      String?           @map("user_id") @db.Uuid
  type        StockMovementType
  // Signed: positif = IN, negatif = OUT. Meniru pola CreditLedger.amount.
  qtyChange   Float             @map("qty_change")
  unitCost    Float?            @map("unit_cost")
  /// Harga jual aktual per unit saat SALE_OUT. Nullable: penjualan lama belum
  /// menyimpan harga jual, sehingga laporan produk menandainya terpisah dan
  /// tidak menganggapnya pendapatan nol.
  unitPrice   Float?            @map("unit_price")
  /// Tanggal bisnis mutasi (mis. penjualan yang dicatat mundur). Nullable:
  /// baris lama memakai `createdAt` sebagai fallback di laporan.
  occurredAt  DateTime?         @map("occurred_at")
  // Soft-reference (bukan relasi Prisma), meniru pola WorkspaceFile.linkedRecordIds --
  // mis. sourceType="purchase_order", sourceId=<PurchaseOrder.id>.
  sourceType  String?           @map("source_type") @db.VarChar(50)
  sourceId    String?           @map("source_id") @db.Uuid
  note        String?
  // Additive 10 Sep 2026 (Fable) -- kontrak inventory-api-schema, F3b/F4. Soft-relasi
  // ke Customer (nullable, opsional) supaya penjualan SALE_OUT bisa dikaitkan ke
  // pembeli terstruktur untuk fitur "restock per toko/wilayah" (Distributor). Ditaruh
  // di StockMovement (bukan CashTransaction) karena rekomendasi restock per-customer
  // butuh GROUP BY dari baris barang KELUAR, bukan sisi kas -- lihat
  // 2026-09-10-scan-kebutuhan-data-modul-7.md bagian 3.3. onDelete SetNull: Customer
  // dihapus tidak menghapus histori StockMovement lama, cuma customerId-nya jadi null.
  customerId  String?           @map("customer_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, productId, createdAt])
  @@index([workspaceId, type])
  @@index([workspaceId, sourceType, sourceId])
  @@index([workspaceId, customerId, createdAt])
  @@map("stock_movements")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @map("workspace_id") @db.Uuid
  userId            String?             @map("user_id") @db.Uuid
  poNumber          String              @map("po_number") @db.VarChar(50)
  supplierName      String              @map("supplier_name") @db.VarChar(150)
  supplierPhone     String?             @map("supplier_phone") @db.VarChar(50)
  status            PurchaseOrderStatus @default(RECEIVED)
  totalAmount       Float               @map("total_amount")
  paymentMethod     String              @default("TUNAI") @map("payment_method") @db.VarChar(50)
  purchaseDate      DateTime            @map("purchase_date")
  notes             String?
  // Soft-link (bukan relasi Prisma) ke CashTransaction -- model CashTransaction tidak
  // disentuh sama sekali.
  cashTransactionId String?             @map("cash_transaction_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]

  @@unique([workspaceId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  qty             Float
  unitCost        Float  @map("unit_cost")
  subtotal        Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_order_items")
}

// Retur stok: barang balik ke supplier (TO_SUPPLIER, mis. rusak/salah kirim) atau
// balik dari pelanggan (FROM_CUSTOMER, mis. komplain/tukar). Additive-only, meniru
// pola soft-reference sourceType/sourceId dan soft-link cashTransactionId di StockMovement.
model StockReturn {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  // String bebas bukan enum, konsisten pola "unit"/"ownershipType" -- "TO_SUPPLIER" atau
  // "FROM_CUSTOMER".
  direction         String   @db.VarChar(20)
  qty               Float
  reason            String?
  // Soft-reference (bukan relasi Prisma), meniru pola StockMovement.sourceType/sourceId.
  sourceType        String?  @map("source_type") @db.VarChar(50)
  sourceId          String?  @map("source_id") @db.Uuid
  // Soft-link (bukan relasi Prisma) ke CashTransaction -- model CashTransaction tidak
  // disentuh sama sekali, meniru pola PurchaseOrder.cashTransactionId.
  cashTransactionId String?  @map("cash_transaction_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([workspaceId, productId, createdAt])
  @@index([workspaceId, direction])
  @@index([workspaceId, sourceType, sourceId])
  @@map("stock_returns")
}

// Skor supplier berdiri sendiri -- TIDAK terhubung ke CompanyHealthScore (breakdown
// 35/30/20/15 HARAM diubah). Dipakai untuk fitur rekomendasi supplier terpisah.
model SupplierScore {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  supplierName     String    @map("supplier_name") @db.VarChar(150)
  score            Float     @default(0)
  onTimeRate       Float?    @map("on_time_rate")
  priceStability   Float?    @map("price_stability")
  defectRate       Float?    @map("defect_rate")
  lastCalculatedAt DateTime? @map("last_calculated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, supplierName])
  @@map("supplier_scores")
}

// Additive 10 Sep 2026 (Fable) -- batch BANGUN gabungan F3b/F4, kontrak
// inventory-api-schema. Skema persis 2026-09-10-scan-kebutuhan-data-modul-7.md
// bagian 3.2. Batch/kadaluarsa DIPISAH dari Product (bukan kolom di Product) karena
// 1 produk bisa punya banyak batch beda tanggal kadaluarsa -- Product.currentStock
// (angka tunggal, cache running-balance lama) TETAP jadi sumber kebenaran utama untuk
// SEMUA fitur lama (restock, dead-stock, turnover currentStock, dsb) - ProductBatch
// HANYA dipakai fitur BARU (alert kadaluarsa, urutan FEFO). qty di sini murni
// pembagian/pencatatan dari stok yang sudah ada di Product.currentStock -- endpoint
// POST batch di kontrak ini SENGAJA TIDAK mengubah Product.currentStock (lihat komentar
// di product-batches/route.ts). Sinkronisasi penuh (StockMovement SALE_OUT ikut
// mengurangi qty batch tertentu secara FEFO) masih didesain terpisah, di luar kontrak ini.
model ProductBatch {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  batchCode   String?  @map("batch_code") @db.VarChar(100)
  expiryDate  DateTime @map("expiry_date")
  qty         Float
  // Soft-link (bukan relasi Prisma), meniru pola StockMovement.sourceType/sourceId.
  sourceType  String?  @map("source_type") @db.VarChar(50)
  sourceId    String?  @map("source_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, productId, expiryDate])
  @@index([workspaceId, expiryDate])
  @@map("product_batches")
}

// Additive 10 Sep 2026 (Fable) -- batch BANGUN gabungan F3b/F4, kontrak
// inventory-api-schema. Skema persis 2026-09-10-scan-kebutuhan-data-modul-7.md
// bagian 3.3 (Distributor: pelanggan/toko + wilayah). area & type sengaja String
// bebas bukan enum, konsisten pola "unit"/"ownershipType"/"direction" di file ini --
// istilah wilayah/jenis pelanggan masih bisa berubah dari hasil survei Distributor
// yang belum selesai. Field customerName teks bebas yang sudah ada di
// sales/route.ts (ditempel ke CashTransaction.description) TIDAK dihapus/diubah --
// tetap ada untuk pembeli lewat/jalan yang belum terdaftar sebagai Customer.
model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(150)
  phone       String?  @db.VarChar(50)
  address     String?
  area        String?  @db.VarChar(100)
  type        String   @default("LAINNYA") @db.VarChar(20)
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([workspaceId, area])
  @@index([workspaceId, name])
  @@map("customers")
}

// ============================================================================
// MODUL LAPORAN KEUANGAN (DOUBLE-ENTRY)
// Additive 19 Okt 2026. Semua nominal uang memakai Decimal(18,2) -- bukan Float --
// supaya penjumlahan tidak terkena pembulatan biner. CashTransaction.amount yang
// lama tetap Float (legacy) dan dikonversi di batas (lihat src/lib/accounting/money.ts).
// Prinsip: seluruh laporan membaca journal_lines, TIDAK PERNAH cash_transactions.
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum CashAccountType {
  CASH
  BANK
}

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum JournalSource {
  MANUAL
  CASH_TX
  INVOICE
  INVOICE_PAYMENT
  OBLIGATION
  OBLIGATION_PAYMENT
  PAYROLL
  OPENING
  ADJUSTMENT
  CLOSING
  REVERSAL
  // Jurnal persediaan: HPP saat penjualan, retur, dan penyesuaian stok.
  INVENTORY
  // Additive 22 Okt 2026 -- Manajemen Aset & Penyusutan.
  ASSET_DEPRECIATION
  ASSET_DISPOSAL
  ASSET_IMPAIRMENT
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum PeriodStatus {
  OPEN
  CLOSING
  CLOSED
  LOCKED
}

enum TaxProfile {
  UMKM_NON_PKP
  UMKM_PKP
  BADAN_NORMAL
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  code          String        @db.VarChar(20)
  name          String        @db.VarChar(150)
  type          AccountType
  normalBalance NormalBalance @map("normal_balance")
  parentId      String?       @map("parent_id") @db.Uuid
  // Akun header (mis. "1-1000 Aset Lancar") tidak boleh dipakai di jurnal.
  isPostable    Boolean       @default(true) @map("is_postable")
  // Akun sistem tidak boleh dihapus karena dipakai logika auto-posting.
  isSystem      Boolean       @default(false) @map("is_system")
  isActive      Boolean       @default(true) @map("is_active")
  description   String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  workspace                     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent                        Account?             @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                      Account[]            @relation("AccountTree")
  lines                         JournalLine[]
  cashAccounts                  CashAccount[]
  categoryMaps                  CategoryAccountMap[]
  budgets                       Budget[]
  budgetAlerts                  BudgetAlert[]
  cashSettlements               CashTransaction[]    @relation("CashSettlementAccount")
  assetAccounts                 Asset[]              @relation("AssetAccount")
  depreciationExpenseAssets     Asset[]              @relation("DepreciationExpenseAccount")
  accumulatedDepreciationAssets Asset[]              @relation("AccumulatedDepreciationAccount")
  taxAccountMaps                TaxAccountMap[]

  @@unique([workspaceId, code])
  @@index([workspaceId, type])
  @@index([workspaceId, parentId])
  @@map("accounts")
}

model CashAccount {
  id                    String          @id @default(uuid()) @db.Uuid
  workspaceId           String          @map("workspace_id") @db.Uuid
  code                  String          @db.VarChar(20)
  name                  String          @db.VarChar(100)
  type                  CashAccountType
  // Akun CoA tempat saldo rekening ini dicatat (mis. 1-1110 Kas).
  accountId             String          @map("account_id") @db.Uuid
  bankName              String?         @map("bank_name") @db.VarChar(100)
  accountNumber         String?         @map("account_number") @db.VarChar(50)
  isActive              Boolean         @default(true) @map("is_active")
  // Rekonsiliasi bank: tracking terakhir kali direkonsiliasi
  lastReconciledAt      DateTime?       @map("last_reconciled_at")
  lastReconciledBalance Decimal?        @map("last_reconciled_balance") @db.Decimal(18, 2)
  createdAt             DateTime        @default(now()) @map("created_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account        Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lines          JournalLine[]
  bankStatements BankStatement[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive])
  @@map("cash_accounts")
}

// ============================================================================
// REKONSILIASI BANK (Additive 2026-10-22)
// ============================================================================

enum BankStatementStatus {
  UPLOADED
  PARSING
  PARSED
  PARSE_FAILED
  RECONCILING
  RECONCILED
  ARCHIVED
}

enum BankLineDirection {
  MASUK
  KELUAR
}

enum BankMatchStatus {
  MATCHED
  AUTO_MATCHED
  MANUAL_MATCHED
  UNMATCHED_BANK
  UNMATCHED_CASH
  IGNORED
  DISPUTED
}

model BankStatement {
  id             String              @id @default(uuid()) @db.Uuid
  workspaceId    String              @map("workspace_id") @db.Uuid
  cashAccountId  String              @map("cash_account_id") @db.Uuid
  fileName       String              @map("file_name") @db.VarChar(255)
  fileHash       String              @map("file_hash") @db.VarChar(64)
  statementDate  DateTime            @map("statement_date")
  startDate      DateTime            @map("start_date")
  endDate        DateTime            @map("end_date")
  openingBalance Decimal             @map("opening_balance") @db.Decimal(18, 2)
  closingBalance Decimal             @map("closing_balance") @db.Decimal(18, 2)
  currency       String              @default("IDR") @db.VarChar(3)
  status         BankStatementStatus @default(UPLOADED) @map("status")
  uploadedBy     String              @map("uploaded_by") @db.Uuid
  parsedAt       DateTime?           @map("parsed_at")
  reconciledAt   DateTime?           @map("reconciled_at")
  notes          String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cashAccount  CashAccount         @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  lines        BankStatementLine[]
  matchedLines BankMatchedLine[]

  @@unique([workspaceId, fileHash])
  @@index([workspaceId, cashAccountId, statementDate])
  @@map("bank_statements")
}

model BankStatementLine {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  statementId     String            @map("statement_id") @db.Uuid
  rowNumber       Int               @map("row_number")
  transactionDate DateTime          @map("transaction_date")
  valueDate       DateTime?         @map("value_date")
  description     String            @db.Text
  referenceNumber String?           @map("reference_number") @db.VarChar(100)
  debitAmount     Decimal?          @map("debit_amount") @db.Decimal(18, 2)
  creditAmount    Decimal?          @map("credit_amount") @db.Decimal(18, 2)
  balance         Decimal?          @map("balance") @db.Decimal(18, 2)
  direction       BankLineDirection @map("direction")
  rawData         Json?             @map("raw_data")
  isValid         Boolean           @default(true) @map("is_valid")
  parseError      String?           @map("parse_error")
  createdAt       DateTime          @default(now()) @map("created_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  statement   BankStatement    @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedLine BankMatchedLine?

  @@index([workspaceId, statementId])
  @@index([workspaceId, transactionDate])
  @@map("bank_statement_lines")
}

model BankMatchedLine {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  statementId       String          @map("statement_id") @db.Uuid
  statementLineId   String          @unique @map("statement_line_id") @db.Uuid
  cashTransactionId String?         @map("cash_transaction_id") @db.Uuid
  status            BankMatchStatus @default(AUTO_MATCHED) @map("status")
  matchScore        Float?          @map("match_score")
  dateDiffDays      Int?            @map("date_diff_days")
  amountDiff        Decimal?        @map("amount_diff") @db.Decimal(18, 2)
  matchedBy         String?         @map("matched_by") @db.Uuid
  matchedAt         DateTime?       @map("matched_at")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  statement       BankStatement     @relation(fields: [statementId], references: [id], onDelete: Cascade)
  statementLine   BankStatementLine @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  cashTransaction CashTransaction?  @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)
  matchedByUser   User?             @relation("BankMatchedLineUser", fields: [matchedBy], references: [id], onDelete: SetNull)

  @@index([workspaceId, statementId, status])
  @@index([workspaceId, cashTransactionId])
  @@map("bank_matched_lines")
}

model Partner {
  id              String      @id @default(uuid()) @db.Uuid
  workspaceId     String      @map("workspace_id") @db.Uuid
  name            String      @db.VarChar(150)
  type            PartnerType @default(CUSTOMER)
  email           String?     @db.VarChar(255)
  phone           String?     @db.VarChar(50)
  address         String?
  npwp            String?     @db.VarChar(30)
  isActive        Boolean     @default(true) @map("is_active")
  notes           String?
  // Additive -- Pengelolaan Utang & Piutang. Kebijakan kredit per pihak lawan:
  // termin hari (dipakai menurunkan dueDate dokumen baru), plafon kredit, tarif
  // pajak bawaan, dan daftar hitam (hanya peringatan, belum memblokir transaksi).
  paymentTermDays Int         @default(30) @map("payment_term_days")
  creditLimit     Decimal?    @map("credit_limit") @db.Decimal(18, 2)
  defaultTaxRate  Float?      @map("default_tax_rate")
  isBlacklisted   Boolean     @default(false) @map("is_blacklisted")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines                JournalLine[]
  invoices             Invoice[]
  obligations          ScheduledObligation[]
  collectionActivities CollectionActivity[]

  @@index([workspaceId, type])
  @@index([workspaceId, name])
  @@map("partners")
}

// ============================================================================
// PENGELOLAAN UTANG & PIUTANG (AR/AP) -- Additive.
// Jejak penagihan piutang (dunning history). Setiap pengingat/penagihan yang
// dikirim ke pelanggan dicatat di sini supaya bisa dipertanggungjawabkan, dan
// `lastReminderAt` di Invoice menjadi ringkasan cepatnya.
// ============================================================================

enum CollectionChannel {
  WHATSAPP
  EMAIL
  PHONE
  VISIT
  OTHER
}

enum CollectionOutcome {
  /// Baru disiapkan/draft, belum benar-benar dikirim.
  DRAFT
  /// Sudah dikirim, menunggu respons.
  SENT
  /// Pelanggan berjanji membayar pada tanggal tertentu (`promisedAt`).
  PROMISED_PAYMENT
  /// Pelanggan membayar setelah penagihan.
  PAID
  /// Pelanggan menyanggah/menyengketakan tagihan.
  DISPUTED
  /// Tidak ada respons.
  NO_RESPONSE
}

model CollectionActivity {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  invoiceId       String?           @map("invoice_id") @db.Uuid
  partnerId       String?           @map("partner_id") @db.Uuid
  channel         CollectionChannel @default(WHATSAPP)
  outcome         CollectionOutcome @default(SENT)
  /// Nada penagihan: soft / normal / firm / legal (bebas, mengikuti dunning level).
  tone            String?           @db.VarChar(20)
  note            String?
  /// Sisa tagihan saat penagihan dilakukan, untuk konteks nominal yang dikejar.
  amountAtRisk    Decimal?          @map("amount_at_risk") @db.Decimal(18, 2)
  /// Tanggal janji bayar bila outcome = PROMISED_PAYMENT.
  promisedAt      DateTime?         @map("promised_at")
  /// Tanggal bisnis aktivitas penagihan (terpisah dari createdAt).
  activityDate    DateTime          @default(now()) @map("activity_date")
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  partner   Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, invoiceId])
  @@index([workspaceId, partnerId])
  @@index([workspaceId, activityDate])
  @@map("collection_activities")
}

model FiscalPeriod {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  year        Int
  month       Int
  startDate   DateTime     @map("start_date")
  endDate     DateTime     @map("end_date")
  status      PeriodStatus @default(OPEN)
  closedAt    DateTime?    @map("closed_at")
  closedBy    String?      @map("closed_by") @db.Uuid
  lockedAt    DateTime?    @map("locked_at")
  lockedBy    String?      @map("locked_by") @db.Uuid

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   JournalEntry[]

  @@unique([workspaceId, year, month])
  @@index([workspaceId, status])
  @@map("fiscal_periods")
}

model JournalEntry {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  periodId     String        @map("period_id") @db.Uuid
  entryNumber  String        @map("entry_number") @db.VarChar(30)
  entryDate    DateTime      @map("entry_date")
  description  String
  source       JournalSource
  // Dokumen sumber (CashTransaction.id, Invoice.id, dst). Null untuk MANUAL/OPENING.
  sourceId     String?       @map("source_id") @db.Uuid
  status       JournalStatus @default(DRAFT)
  totalDebit   Decimal       @map("total_debit") @db.Decimal(18, 2)
  totalCredit  Decimal       @map("total_credit") @db.Decimal(18, 2)
  createdBy    String        @map("created_by") @db.Uuid
  postedBy     String?       @map("posted_by") @db.Uuid
  postedAt     DateTime?     @map("posted_at")
  reversalOfId String?       @unique @map("reversal_of_id") @db.Uuid
  reversedBy   String?       @map("reversed_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  period              FiscalPeriod        @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines               JournalLine[]
  reversalOf          JournalEntry?       @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversed            JournalEntry?       @relation("JournalReversal")
  depreciationEntries DepreciationEntry[] @relation("DepreciationJournalEntry")
  impairmentEntries   AssetImpairment[]   @relation("ImpairmentJournalEntry")

  // Cegah jurnal dobel bila dokumen sumber diproses ulang.
  // sourceId NULL (MANUAL/OPENING) boleh berulang -- perilaku default Postgres.
  @@unique([workspaceId, source, sourceId])
  @@unique([workspaceId, entryNumber])
  @@index([workspaceId, entryDate])
  @@index([workspaceId, status])
  @@index([workspaceId, periodId])
  @@map("journal_entries")
}

model JournalLine {
  id            String  @id @default(uuid()) @db.Uuid
  workspaceId   String  @map("workspace_id") @db.Uuid
  entryId       String  @map("entry_id") @db.Uuid
  lineNo        Int     @map("line_no")
  accountId     String  @map("account_id") @db.Uuid
  cashAccountId String? @map("cash_account_id") @db.Uuid
  partnerId     String? @map("partner_id") @db.Uuid
  description   String?
  debit         Decimal @default(0) @db.Decimal(18, 2)
  credit        Decimal @default(0) @db.Decimal(18, 2)
  currency      String  @default("IDR") @db.VarChar(3)
  exchangeRate  Decimal @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  costCenter    String? @map("cost_center") @db.VarChar(50)
  /// Dimensi proyek untuk analisis laba per proyek. Nullable: baris lama dan
  /// baris yang memang tidak terkait proyek tetap sah ("Tanpa Proyek").
  projectId     String? @map("project_id") @db.Uuid

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  partner     Partner?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([entryId, lineNo])
  @@index([workspaceId, accountId])
  @@index([workspaceId, partnerId])
  @@index([workspaceId, cashAccountId])
  @@index([workspaceId, projectId])
  @@map("journal_lines")
}

model AccountingSetting {
  id                         String     @id @default(uuid()) @db.Uuid
  workspaceId                String     @unique @map("workspace_id") @db.Uuid
  isEnabled                  Boolean    @default(false) @map("is_enabled")
  booksStartDate             DateTime?  @map("books_start_date")
  taxProfile                 TaxProfile @default(UMKM_NON_PKP) @map("tax_profile")
  entityType                 String     @default("BADAN_USAHA") @map("entity_type") @db.VarChar(30)
  fiscalYearStartMonth       Int        @default(1) @map("fiscal_year_start_month")
  retainedEarningsAccountId  String?    @map("retained_earnings_account_id") @db.Uuid
  currentYearProfitAccountId String?    @map("current_year_profit_account_id") @db.Uuid
  defaultCashAccountId       String?    @map("default_cash_account_id") @db.Uuid
  // Akun pendapatan yang dipakai saat faktur (AR) diterbitkan. Faktur hanya
  // menyimpan daftar item (nama/harga/qty) tanpa kategori akun, jadi owner
  // memilih SATU akun pendapatan default di Pengaturan.
  defaultRevenueAccountId    String?    @map("default_revenue_account_id") @db.Uuid
  enablePpn                  Boolean    @default(false) @map("enable_ppn")
  enableInventory            Boolean    @default(false) @map("enable_inventory")

  // Additive 22 Okt 2026 -- identitas & parameter pajak untuk Modul Pajak.
  // Tarif disimpan sebagai persen (11 = 11%), bukan pecahan, supaya sama dengan
  // cara akuntan menuliskannya dan tidak salah baca di UI.
  npwp               String?   @db.VarChar(30)
  nik                String?   @db.VarChar(20)
  pkpEffectiveDate   DateTime? @map("pkp_effective_date")
  kppName            String?   @map("kpp_name") @db.VarChar(150)
  ppnRate            Decimal   @default(11) @map("ppn_rate") @db.Decimal(5, 2)
  pphFinalRate       Decimal   @default(0.5) @map("pph_final_rate") @db.Decimal(5, 2)
  umkmThreshold      Decimal   @default(500000000) @map("umkm_threshold") @db.Decimal(18, 2)
  pph21Method        String    @default("MANUAL") @map("pph21_method") @db.VarChar(30)
  pph23Rate          Decimal   @default(2) @map("pph23_rate") @db.Decimal(5, 2)
  pph42Rate          Decimal   @default(10) @map("pph42_rate") @db.Decimal(5, 2)
  taxReminderDays    Int[]     @default([30, 14, 7, 3, 1]) @map("tax_reminder_days")
  taxReminderChannel String    @default("IN_APP") @map("tax_reminder_channel") @db.VarChar(30)

  createdAt                  DateTime   @default(now()) @map("created_at")
  updatedAt                  DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("accounting_settings")
}

model CategoryAccountMap {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  category    String      @db.VarChar(100)
  type        AccountType
  accountId   String      @map("account_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, category, type])
  @@map("category_account_maps")
}

/// Anggaran tahunan per akun pendapatan/beban, per divisi.
///
/// `fiscalYear` = tahun kalender saat tahun buku DIMULAI (Januari untuk tahun
/// buku normal). `monthly` berisi 12 angka berurutan mulai dari bulan pertama
/// tahun buku, sehingga tahun buku yang mulai April tetap punya 12 slot.
///
/// `division` memecah anggaran per divisi. Satu baris = (divisi, akun); TOTAL
/// per divisi adalah JUMLAH barisnya, bukan entitas tersendiri. "Anggaran bebas"
/// bukan konsep terpisah: alokasikan seluruh anggaran divisi ke satu akun beban
/// umum. Nilai `PERUSAHAAN` dipakai baris lama (sebelum ada dimensi divisi) dan
/// untuk anggaran yang memang sifatnya umum.
///
/// Anggaran murni rencana: tidak pernah membuat jurnal dan tidak memengaruhi
/// laporan utama. Realisasi dihitung dari jurnal yang sama dengan Laba Rugi,
/// disaring lewat `JournalLine.costCenter`.
model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  fiscalYear  Int      @map("fiscal_year")
  accountId   String   @map("account_id") @db.Uuid
  /// Divisi pemilik anggaran. Non-null: baris lama otomatis `PERUSAHAAN`.
  division    String   @default("PERUSAHAAN") @db.VarChar(30)
  monthly     Json     @db.JsonB
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fiscalYear, accountId, division])
  @@index([workspaceId, fiscalYear])
  @@index([workspaceId, fiscalYear, division])
  @@map("budgets")
}

enum BudgetAlertLevel {
  /// Realisasi mendekati batas (default 80% anggaran YTD).
  WARNING
  /// Realisasi melewati batas (100% anggaran YTD).
  EXCEEDED
}

/// Peringatan anggaran: realisasi sebuah baris anggaran (divisi + akun) sudah
/// menyentuh ambang batas pada bulan tertentu tahun buku berjalan.
///
/// Dibuat ulang (bukan ditumpuk) oleh `evaluateBudgetAlerts`, sehingga unique
/// constraint di bawah sekaligus berfungsi sebagai mekanisme dedup -- evaluasi
/// ulang yang berulang tidak pernah menghasilkan notifikasi ganda.
///
/// `accountId` sengaja NON-NULL (satu alert per baris anggaran). Kalau nullable,
/// unique constraint tidak akan mencegah duplikat karena NULL tidak pernah sama
/// dengan NULL di Postgres. Ringkasan per divisi dihitung di UI, bukan disimpan.
model BudgetAlert {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  fiscalYear     Int              @map("fiscal_year")
  /// Posisi bulan dalam tahun buku (0–11), konsisten dengan slot `monthly`.
  monthIndex     Int              @map("month_index")
  division       String           @db.VarChar(30)
  accountId      String           @map("account_id") @db.Uuid
  level          BudgetAlertLevel
  budget         Decimal          @db.Decimal(18, 2)
  actual         Decimal          @db.Decimal(18, 2)
  triggeredAt    DateTime         @default(now()) @map("triggered_at")
  acknowledgedAt DateTime?        @map("acknowledged_at")
  acknowledgedBy String?          @map("acknowledged_by") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fiscalYear, monthIndex, division, accountId, level])
  @@index([workspaceId, fiscalYear, monthIndex])
  @@index([workspaceId, acknowledgedAt])
  @@map("budget_alerts")
}

model FinancialScenario {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  name         String   @db.VarChar(120)
  description  String?  @db.Text
  baselineJson Json     @map("baseline_json")
  paramsJson   Json     @map("params_json")
  resultsJson  Json?    @map("results_json")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
  @@map("financial_scenarios")
}

model DocumentSequence {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  key         String @db.VarChar(30)
  nextNumber  Int    @default(1) @map("next_number")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("document_sequences")
}

// Backup records for database/system backup operations.
model Backup {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  backupType  String   @map("backup_type")
  data        Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by_id") @db.Uuid

  workspaceBackrefs Workspace[] @relation("WorkspaceBackups")
  creator           User        @relation("UserBackups", fields: [createdById], references: [id])

  @@index([workspaceId, createdAt])
  @@map("backups")
}

// Audit log for tracking all system and accounting actions.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  changes     Json?
  metadata    Json?
  /// Alasan koreksi/pembatalan. Wajib diisi pada aksi yang mengubah atau
  /// membatalkan dokumen keuangan; null untuk aksi create murni.
  reason      String?  @db.Text
  timestamp   DateTime @default(now()) @map("timestamp")

  workspace Workspace @relation("WorkspaceAuditLogs", fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([workspaceId, timestamp])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// MANAJEMEN ASET & PENYUSUTAN -- Additive 22 Okt 2026
//
// Mencatat aset perusahaan (nilai perolehan, masa manfaat), menghitung
// penyusutan dengan 4 metode (garis lurus, saldo menurun, unit produksi,
// jumlah angka tahun), memantau lokasi & penanggung jawab, serta menyimpan
// riwayat pemeliharaan, mutasi, penurunan nilai, dan pelepasan aset.
//
// Semua nominal uang memakai Decimal(18,2) seperti modul laporan keuangan.
// `Asset.accumulatedDepreciation` adalah cache dari jumlah DepreciationEntry
// yang sudah diposting; sumber kebenaran tetap entri per periode.
// ============================================================================

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DISPOSED
  SOLD
  TRANSFERRED
  IMPAIRED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  UNITS_OF_PRODUCTION
  SUM_OF_YEARS_DIGITS
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  UPGRADE
  OTHER
}

enum DisposalMethod {
  SALE
  SCRAP
  DONATION
  TRANSFER
  LOSS
  WRITE_OFF
}

model AssetCategory {
  id                        String              @id @default(uuid()) @db.Uuid
  workspaceId               String              @map("workspace_id") @db.Uuid
  code                      String              @db.VarChar(20)
  name                      String              @db.VarChar(100)
  description               String?             @db.Text
  defaultUsefulLifeMonths   Int?                @map("default_useful_life_months")
  defaultDepreciationMethod DepreciationMethod? @map("default_depreciation_method")
  /// Persentase nilai sisa terhadap harga perolehan (0-100).
  defaultSalvageValueRate   Float?              @default(0) @map("default_salvage_value_rate")
  /// Kategori bawaan sistem (hasil seed) tidak boleh dihapus.
  isSystem                  Boolean             @default(false) @map("is_system")
  parentId                  String?             @map("parent_id") @db.Uuid
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    AssetCategory?  @relation("AssetCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  AssetCategory[] @relation("AssetCategoryTree")
  assets    Asset[]

  @@unique([workspaceId, code])
  @@index([workspaceId, parentId])
  @@map("asset_categories")
}

model Asset {
  id           String  @id @default(uuid()) @db.Uuid
  workspaceId  String  @map("workspace_id") @db.Uuid
  categoryId   String  @map("category_id") @db.Uuid
  assetCode    String  @map("asset_code") @db.VarChar(50)
  name         String  @db.VarChar(255)
  description  String? @db.Text
  brand        String? @db.VarChar(100)
  model        String? @db.VarChar(100)
  serialNumber String? @map("serial_number") @db.VarChar(100)

  // ── Perolehan ──────────────────────────────────────────────────────────
  acquisitionDate  DateTime @map("acquisition_date")
  acquisitionCost  Decimal  @map("acquisition_cost") @db.Decimal(18, 2)
  salvageValue     Decimal  @default(0) @map("salvage_value") @db.Decimal(18, 2)
  usefulLifeMonths Int      @map("useful_life_months")
  /// Tanah dan aset seni umumnya tidak disusutkan (masa manfaat 0).
  isDepreciable    Boolean  @default(true) @map("is_depreciable")

  // ── Penyusutan ─────────────────────────────────────────────────────────
  depreciationMethod      DepreciationMethod @map("depreciation_method")
  /// Awal penyusutan; kosong = tanggal perolehan.
  depreciationStartDate   DateTime?          @map("depreciation_start_date")
  lastDepreciationDate    DateTime?          @map("last_depreciation_date")
  accumulatedDepreciation Decimal            @default(0) @map("accumulated_depreciation") @db.Decimal(18, 2)
  /// Total kerugian penurunan nilai yang sudah diakui (terpisah dari penyusutan).
  accumulatedImpairment   Decimal            @default(0) @map("accumulated_impairment") @db.Decimal(18, 2)

  // Khusus metode unit produksi.
  totalEstimatedUnits Decimal? @map("total_estimated_units") @db.Decimal(18, 2)
  unitsProducedToDate Decimal  @default(0) @map("units_produced_to_date") @db.Decimal(18, 2)

  // ── Lokasi & penanggung jawab ──────────────────────────────────────────
  location    String? @db.VarChar(255)
  custodianId String? @map("custodian_id") @db.Uuid
  department  String? @db.VarChar(100)

  // ── Status & pelepasan ─────────────────────────────────────────────────
  status           AssetStatus     @default(ACTIVE)
  disposalDate     DateTime?       @map("disposal_date")
  disposalMethod   DisposalMethod? @map("disposal_method")
  disposalProceeds Decimal?        @map("disposal_proceeds") @db.Decimal(18, 2)
  disposalGainLoss Decimal?        @map("disposal_gain_loss") @db.Decimal(18, 2)
  disposalNotes    String?         @map("disposal_notes") @db.Text

  // ── Integrasi akuntansi (opsional; kosong = akun bawaan) ───────────────
  assetAccountId                   String? @map("asset_account_id") @db.Uuid
  depreciationExpenseAccountId     String? @map("depreciation_expense_account_id") @db.Uuid
  accumulatedDepreciationAccountId String? @map("accumulated_depreciation_account_id") @db.Uuid

  // ── Jejak dokumen sumber ───────────────────────────────────────────────
  sourceFileId        String? @map("source_file_id") @db.Uuid
  sourceTransactionId String? @map("source_transaction_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  workspace                      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category                       AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  custodian                      User?         @relation("AssetCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  creator                        User          @relation("AssetCreator", fields: [createdBy], references: [id])
  updater                        User?         @relation("AssetUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  assetAccount                   Account?      @relation("AssetAccount", fields: [assetAccountId], references: [id], onDelete: SetNull)
  depreciationExpenseAccount     Account?      @relation("DepreciationExpenseAccount", fields: [depreciationExpenseAccountId], references: [id], onDelete: SetNull)
  accumulatedDepreciationAccount Account?      @relation("AccumulatedDepreciationAccount", fields: [accumulatedDepreciationAccountId], references: [id], onDelete: SetNull)

  depreciationEntries DepreciationEntry[]
  maintenanceRecords  AssetMaintenance[]
  transferHistory     AssetTransfer[]
  impairmentRecords   AssetImpairment[]

  @@unique([workspaceId, assetCode])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, status])
  @@index([workspaceId, custodianId])
  @@index([workspaceId, location])
  @@map("assets")
}

model DepreciationEntry {
  id                      String  @id @default(uuid()) @db.Uuid
  workspaceId             String  @map("workspace_id") @db.Uuid
  assetId                 String  @map("asset_id") @db.Uuid
  periodYear              Int     @map("period_year")
  periodMonth             Int     @map("period_month")
  depreciationAmount      Decimal @map("depreciation_amount") @db.Decimal(18, 2)
  accumulatedDepreciation Decimal @map("accumulated_depreciation") @db.Decimal(18, 2)
  bookValue               Decimal @map("book_value") @db.Decimal(18, 2)

  /// Diisi hanya untuk metode unit produksi pada periode ini.
  unitsProduced Decimal? @map("units_produced") @db.Decimal(18, 2)

  journalEntryId String?   @map("journal_entry_id") @db.Uuid
  isPosted       Boolean   @default(false) @map("is_posted")
  postedAt       DateTime? @map("posted_at")
  postedBy       String?   @map("posted_by") @db.Uuid

  isAdjustment     Boolean @default(false) @map("is_adjustment")
  adjustmentReason String? @map("adjustment_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation("DepreciationJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, assetId, periodYear, periodMonth])
  @@index([workspaceId, periodYear, periodMonth])
  @@index([workspaceId, assetId, isPosted])
  @@map("depreciation_entries")
}

model AssetMaintenance {
  id                  String          @id @default(uuid()) @db.Uuid
  workspaceId         String          @map("workspace_id") @db.Uuid
  assetId             String          @map("asset_id") @db.Uuid
  maintenanceDate     DateTime        @map("maintenance_date")
  type                MaintenanceType @default(PREVENTIVE)
  description         String          @db.Text
  cost                Decimal         @default(0) @db.Decimal(18, 2)
  vendor              String?         @db.VarChar(255)
  performedBy         String?         @map("performed_by") @db.VarChar(255)
  nextMaintenanceDate DateTime?       @map("next_maintenance_date")
  notes               String?         @db.Text
  receiptUrl          String?         @map("receipt_url")
  sourceFileId        String?         @map("source_file_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  createdBy           String          @map("created_by") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([workspaceId, assetId, maintenanceDate])
  @@index([workspaceId, maintenanceDate])
  @@map("asset_maintenance")
}

model AssetTransfer {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  assetId         String    @map("asset_id") @db.Uuid
  transferDate    DateTime  @map("transfer_date")
  fromLocation    String?   @map("from_location") @db.VarChar(255)
  toLocation      String    @map("to_location") @db.VarChar(255)
  fromCustodianId String?   @map("from_custodian_id") @db.Uuid
  toCustodianId   String?   @map("to_custodian_id") @db.Uuid
  fromDepartment  String?   @map("from_department") @db.VarChar(100)
  toDepartment    String?   @map("to_department") @db.VarChar(100)
  reason          String?   @db.Text
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String    @map("created_by") @db.Uuid

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromCustodian User?     @relation("AssetTransferFrom", fields: [fromCustodianId], references: [id], onDelete: SetNull)
  toCustodian   User?     @relation("AssetTransferTo", fields: [toCustodianId], references: [id], onDelete: SetNull)

  @@index([workspaceId, assetId, transferDate])
  @@map("asset_transfers")
}

model AssetImpairment {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  impairmentDate    DateTime @map("impairment_date")
  recoverableAmount Decimal  @map("recoverable_amount") @db.Decimal(18, 2)
  carryingAmount    Decimal  @map("carrying_amount") @db.Decimal(18, 2)
  impairmentLoss    Decimal  @map("impairment_loss") @db.Decimal(18, 2)
  description       String   @db.Text
  journalEntryId    String?  @map("journal_entry_id") @db.Uuid
  isPosted          Boolean  @default(false) @map("is_posted")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String   @map("created_by") @db.Uuid

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation("ImpairmentJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, assetId, impairmentDate])
  @@map("asset_impairments")
}

// ============================================================================
// MODUL PAJAK & KALENDER KEPATUHAN -- Additive 22 Okt 2026
//
// Tujuan: menyiapkan administrasi perpajakan (rekap transaksi relevan, kalender
// tenggat, bukti/dokumen pendukung, rekapitulasi per jenis transaksi, ekspor
// untuk akuntan) tanpa mengubah laporan utama. Seluruh nominal pajak memakai
// Decimal(18,2). `CashTransaction` dan `Invoice` tetap menjadi dokumen sumber;
// tabel di bawah hanya menyimpan status administrasi, dokumen, dan potongan
// pajak yang tidak berasal dari payroll.
// ============================================================================

enum TaxType {
  PPH_FINAL_UMKM
  PPN
  PPH_21
  PPH_23
  PPH_4_2
  PPH_26
  BPJS
  OTHER
}

enum TaxComponent {
  OUTPUT
  INPUT
  WITHHOLDING
  PAYABLE
}

enum TaxPeriodStatus {
  OPEN
  READY
  FILED
  PAID
  CLOSED
}

enum ComplianceCategory {
  TAX
  BPJS
  PERMIT
  OTHER
}

enum ComplianceSource {
  TEMPLATE
  CUSTOM
}

enum ComplianceStatus {
  UPCOMING
  DUE_SOON
  OVERDUE
  DONE
  SKIPPED
}

enum Recurrence {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  ONE_OFF
}

enum TaxDocType {
  TAX_INVOICE
  WITHHOLDING_SLIP
  PAYMENT_PROOF
  FILING_RECEIPT
  SUPPORTING
}

enum TaxDocStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Satu baris = satu masa pajak (jenis × tahun × bulan). Angka rekap tidak
/// disimpan di sini kecuali saat pelaporan (`snapshot`) supaya laporan selalu
/// membaca dokumen/jurnal terkini. `paymentRef`/`filingRef` menyimpan NTPN atau
/// nomor bukti lapor, bukan rahasia apa pun.
model TaxPeriod {
  id             String          @id @default(uuid()) @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  taxType        TaxType         @map("tax_type")
  year           Int
  month          Int
  startDate      DateTime        @map("start_date")
  endDate        DateTime        @map("end_date")
  dueDatePayment DateTime?       @map("due_date_payment")
  dueDateFiling  DateTime?       @map("due_date_filing")
  status         TaxPeriodStatus @default(OPEN)
  paymentAmount  Decimal?        @map("payment_amount") @db.Decimal(18, 2)
  filingAmount   Decimal?        @map("filing_amount") @db.Decimal(18, 2)
  filedAt        DateTime?       @map("filed_at")
  filedBy        String?         @map("filed_by") @db.Uuid
  filingRef      String?         @map("filing_ref") @db.VarChar(120)
  paidAt         DateTime?       @map("paid_at")
  paidBy         String?         @map("paid_by") @db.Uuid
  paymentRef     String?         @map("payment_ref") @db.VarChar(120)
  snapshot       Json?           @db.JsonB
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, taxType, year, month])
  @@index([workspaceId, year, month])
  @@index([workspaceId, status])
  @@map("tax_periods")
}

/// Kalender tenggat. Baris `TEMPLATE` lahir dari template nasional dan boleh
/// diubah tanggalnya oleh owner; baris `CUSTOM` dibuat manual. Status
/// UPCOMING/DUE_SOON/OVERDUE dihitung ulang saat dibaca, bukan disimpan permanen.
model ComplianceDeadline {
  id             String             @id @default(uuid()) @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  title          String             @db.VarChar(200)
  description    String?            @db.Text
  category       ComplianceCategory @default(TAX)
  taxType        TaxType?           @map("tax_type")
  dueDate        DateTime           @map("due_date")
  recurrence     Recurrence         @default(ONE_OFF)
  source         ComplianceSource   @default(CUSTOM)
  status         ComplianceStatus   @default(UPCOMING)
  templateKey    String?            @map("template_key") @db.VarChar(80)
  taxPeriodId    String?            @map("tax_period_id") @db.Uuid
  reminderDays   Int[]              @default([7, 3, 1]) @map("reminder_days")
  assignedTo     String?            @map("assigned_to") @db.Uuid
  completedAt    DateTime?          @map("completed_at")
  completedBy    String?            @map("completed_by") @db.Uuid
  evidenceFileId String?            @map("evidence_file_id") @db.Uuid
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dueDate])
  @@index([workspaceId, status])
  @@index([workspaceId, taxType, dueDate])
  @@index([workspaceId, templateKey])
  @@map("compliance_deadlines")
}

/// Bukti transaksi / dokumen pendukung. `fileId` menunjuk `WorkspaceFile`
/// (soft-reference, sama seperti pola `sourceFileId` di model lain) supaya file
/// tetap tersimpan di Pusat Data. `sourceType`/`sourceId` menunjuk dokumen yang
/// dijamin (invoice, payroll, withholding) sehingga checklist bisa menautkan
/// kekurangan dokumen ke transaksi asalnya.
model TaxDocument {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  taxPeriodId String?      @map("tax_period_id") @db.Uuid
  deadlineId  String?      @map("deadline_id") @db.Uuid
  fileId      String?      @map("file_id") @db.Uuid
  docType     TaxDocType   @map("doc_type")
  status      TaxDocStatus @default(PENDING)
  docNumber   String?      @map("doc_number") @db.VarChar(120)
  issueDate   DateTime?    @map("issue_date")
  amount      Decimal?     @db.Decimal(18, 2)
  sourceType  String?      @map("source_type") @db.VarChar(40)
  sourceId    String?      @map("source_id") @db.Uuid
  fileName    String?      @map("file_name") @db.VarChar(255)
  notes       String?
  uploadedBy  String?      @map("uploaded_by") @db.Uuid
  verifiedBy  String?      @map("verified_by") @db.Uuid
  verifiedAt  DateTime?    @map("verified_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, taxPeriodId, docType])
  @@index([workspaceId, deadlineId])
  @@index([workspaceId, sourceType, sourceId])
  @@map("tax_documents")
}

/// Potongan pajak yang tidak berasal dari payroll (PPh 23/4(2)/26) atau koreksi
/// manual. PPh 21 & BPJS tetap dibaca dari `EmployeePayroll` agar tidak ada dua
/// sumber angka. Nilai `taxAmount` disimpan, bukan dihitung ulang saat laporan,
/// karena tarif dapat berubah menurut jenis jasa.
model TaxWithholding {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  taxType     TaxType  @map("tax_type")
  sourceType  String   @default("MANUAL") @map("source_type") @db.VarChar(40)
  sourceId    String?  @map("source_id") @db.Uuid
  partnerId   String?  @map("partner_id") @db.Uuid
  partnerName String?  @map("partner_name") @db.VarChar(150)
  partnerNpwp String?  @map("partner_npwp") @db.VarChar(30)
  dpp         Decimal  @db.Decimal(18, 2)
  rate        Float
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(18, 2)
  periodYear  Int      @map("period_year")
  periodMonth Int      @map("period_month")
  docNumber   String?  @map("doc_number") @db.VarChar(120)
  taxPeriodId String?  @map("tax_period_id") @db.Uuid
  notes       String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceType, sourceId, taxType])
  @@index([workspaceId, periodYear, periodMonth])
  @@index([workspaceId, taxType])
  @@map("tax_withholdings")
}

/// Pemetaan akun COA untuk tiap jenis/komponen pajak. Dipakai untuk
/// rekonsiliasi rekap (dokumen vs jurnal) dan menjadi titik integrasi bila
/// nanti potongan pajak dijurnal otomatis.
model TaxAccountMap {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  taxType     TaxType      @map("tax_type")
  component   TaxComponent
  accountId   String       @map("account_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, taxType, component])
  @@map("tax_account_maps")
}
