  ingestLogs IngestLog[]

  @@index([workspaceId, createdAt])
  @@map("workspace_files")
}

enum FileCategory {
  KEUANGAN
  NOTULEN
  KONTRAK
  KATALOG
  UMUM
}

model IngestLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  fileId      String   @map("file_id") @db.Uuid
  kind        String   @db.VarChar(50)
