// Roadmap 7 Sep, item 4.8 -- FinanceModuleView.tsx punya widget "Kewajiban
// terjadwal" tapi upcomingDues14/30 hardcode array kosong (bukan state, tidak
// pernah fetch). Model Invoice yang ada adalah PIUTANG (uang masuk), model ini
// untuk KEWAJIBAN (uang keluar terjadwal) -- konsep beda, tabel terpisah.
enum ObligationStatus {
  PENDING
  // Sudah dibayar sebagian (Fase 3.2). Sisa utang = amount - paidAmount.
  PARTIAL
  PAID
  CANCELLED
}

model ScheduledObligation {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  name           String           @db.VarChar(150)
  dueDate        DateTime         @map("due_date")
  amount         Float
  // Total pelunasan yang sudah dialokasikan (Fase 3.2). Sisa = amount - paidAmount.
  paidAmount     Float            @default(0) @map("paid_amount")
  status         ObligationStatus @default(PENDING)
  category       String?          @db.VarChar(100)
  // Tanggal & metode pembayaran saat kewajiban dilunasi.
  paidAt         DateTime?        @map("paid_at")
  paymentMethod  String?          @map("payment_method") @db.VarChar(50)
  // Additive -- Pengelolaan Utang & Piutang. Tautan ke master vendor (Partner),
  // nomor tagihan internal, referensi dokumen vendor (invoice/PO), termin kredit,
  // serta snapshot penuaan untuk jadwal pembayaran vendor.
  partnerId      String?          @map("partner_id") @db.Uuid
  billNumber     String?          @map("bill_number") @db.VarChar(50)
  refNumber      String?          @map("ref_number") @db.VarChar(80)
  termDays       Int?             @map("term_days")
  agingBucket    String?          @map("aging_bucket") @db.VarChar(20)
  overdueSince   DateTime?        @map("overdue_since")
  lastReminderAt DateTime?        @map("last_reminder_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partner            Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  cashTransactions   CashTransaction[]
  paymentAllocations PaymentAllocation[]

  @@index([workspaceId, dueDate])
  @@index([workspaceId, status])
  @@index([workspaceId, partnerId])
  @@map("scheduled_obligations")
}

// Additive Fase 3.2 -- Pembayaran sebagian & alokasi dokumen.
// Satu baris kas bisa dialokasikan ke beberapa faktur/kewajiban (split payment),
// dan satu dokumen bisa menerima banyak pembayaran. `Invoice.paidAmount` /
// `ScheduledObligation.paidAmount` adalah ringkasan dari tabel ini.
model PaymentAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  cashTxId        String   @map("cash_tx_id") @db.Uuid
  invoiceId       String?  @map("invoice_id") @db.Uuid
  obligationId    String?  @map("obligation_id") @db.Uuid
  amount          Decimal  @db.Decimal(18, 2)
  // Tanggal bisnis alokasi, dipakai laporan umur agar sisa tagihan tepat per tanggal.
  transactionDate DateTime @map("transaction_date")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cashTx     CashTransaction      @relation("CashAllocations", fields: [cashTxId], references: [id], onDelete: Cascade)
  invoice    Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  obligation ScheduledObligation? @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, invoiceId])
  @@index([workspaceId, obligationId])
  @@index([workspaceId, cashTxId])
  @@map("payment_allocations")
}

// Roadmap 7 Sep, item 4.2/4.1 -- fondasi penyimpanan file (Pusat/Hub Upload Data,
// prioritas #1 versi Mecca). Dicek langsung ke skema sebelum menulis ini: TIDAK ADA
// model File/Upload/Attachment/Document manapun -- upload sekarang (extract-text,
// analyze) proses-lalu-buang, nol penyimpanan. Model ini murni aditif, tidak
// mengubah model/kolom existing manapun. MVP: simpan file sebagai Bytes langsung
// di Postgres (Neon yang sudah dipakai), BUKAN object storage baru -- nol
// infrastruktur tambahan, konsisten filosofi aditif-minimal sesi ini. Migrasi ke
// object storage terpisah bisa jadi kerjaan lanjutan kalau skala membesar.
enum WorkspaceFileStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model WorkspaceFile {
  id               String              @id @default(uuid()) @db.Uuid
  workspaceId      String              @map("workspace_id") @db.Uuid
  uploadedBy       String?             @map("uploaded_by") @db.Uuid
  fileName         String              @map("file_name") @db.VarChar(255)
  fileType         String              @map("file_type") @db.VarChar(100)
  category         FileCategory        @default(UMUM)
  contentHash      String?             @map("content_hash") @db.VarChar(64)
  sizeBytes        Int                 @map("size_bytes")
  storageBlob      Bytes               @map("storage_blob")
  extractedSummary String?             @map("extracted_summary")
  // Id record turunan (mis. CashTransaction) yang lahir dari file ini -- dipakai
  // Hub Upload buat nunjukin "file ini menghasilkan apa" (Bagian 5 roadmap, poin 2).
  linkedRecordIds  String[]            @default([]) @map("linked_record_ids")
  status           WorkspaceFileStatus @default(PROCESSED)
  createdAt        DateTime            @default(now()) @map("created_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
