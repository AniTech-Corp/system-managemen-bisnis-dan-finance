datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.Text
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  memberships      WorkspaceMember[]
  refreshTokens    RefreshToken[]
  creditLedgers    CreditLedger[]
  createdProjects  Project[]         @relation("ProjectCreator")
  memoryItems      MemoryItem[]
  activityEvents   ActivityEvent[]
  resourceGrants   ResourceGrant[]   @relation("UserResourceGrants")
  grantedGrants    ResourceGrant[]   @relation("GrantedResourceGrants")
  cashTransactions CashTransaction[]
  invoices         Invoice[]
  workspaceFiles   WorkspaceFile[]
  stockMovements   StockMovement[]
  purchaseOrders   PurchaseOrder[]

  // Additive 22 Okt 2026 -- Pengeluaran Berjenjang.
  expenseRequests  ExpenseRequest[]  @relation("ExpenseRequestRequester")
  expenseReviews   ExpenseRequest[]  @relation("ExpenseRequestFinanceReviewer")
  expenseApprovals ExpenseApproval[] @relation("ExpenseApprovalApprover")

  userBackups      Backup[]          @relation("UserBackups")
  userAuditLogs    AuditLog[]        @relation("UserAuditLogs")
  bankMatchedLines BankMatchedLine[] @relation("BankMatchedLineUser")

  // Additive 22 Okt 2026 -- Manajemen Aset & Penyusutan.
  custodyAssets      Asset[]         @relation("AssetCustodian")
  createdAssets      Asset[]         @relation("AssetCreator")
  updatedAssets      Asset[]         @relation("AssetUpdater")
  assetTransfersFrom AssetTransfer[] @relation("AssetTransferFrom")
  assetTransfersTo   AssetTransfer[] @relation("AssetTransferTo")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Workspace {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  ownerId        String   @map("owner_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  enabledModules String[] @default(["corplan", "personal", "finance", "advertising", "workspace", "schedule", "inventory"]) @map("enabled_modules")

  industry      String? @db.VarChar(100)
  targetMarket  String? @map("target_market") @db.VarChar(150)
  businessModel String? @map("business_model") @db.VarChar(100)

  owner                User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members              WorkspaceMember[]
  subscription         Subscription?
  creditAccount        CreditAccount?
  creditLedgers        CreditLedger[]
  workspaceAIKeys      WorkspaceAIKey[]
  projects             Project[]
  memoryItems          MemoryItem[]
  activityEvents       ActivityEvent[]
  resourceGrants       ResourceGrant[]
  cashTransactions     CashTransaction[]
  invoices             Invoice[]
  promoCoupons         PromoCoupon[]
  campaigns            Campaign[]
  scheduledObligations ScheduledObligation[]
  budgets              Budget[]
  budgetAlerts         BudgetAlert[]
  financialScenarios   FinancialScenario[]
  workspaceFiles       WorkspaceFile[]
  ingestLogs           IngestLog[]
  contentCalendars     ContentCalendar[]
  workTasks            WorkTask[]
  attendanceRecords    AttendanceRecord[]
  employeePayrolls     EmployeePayroll[]
  bookingReservations  BookingReservation[]
  queueTickets         QueueTicket[]
  videoJobs            VideoJob[]
  products             Product[]
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]
  stockReturns         StockReturn[]
  supplierScores       SupplierScore[]
  // Additive 10 Sep 2026 (Fable) -- Modul 7 batch BANGUN F3b/F4, kontrak
  // inventory-api-schema. Lihat komentar model ProductBatch/Customer di bawah.
  productBatches       ProductBatch[]
  customers            Customer[]

  // Additive 19 Okt 2026 -- Modul Laporan Keuangan (double-entry).
  // Tabel baru murni tambahan; CashTransaction tetap ada sebagai dokumen sumber.
  accounts             Account[]
  cashAccounts         CashAccount[]
  partners             Partner[]
  fiscalPeriods        FiscalPeriod[]
  journalEntries       JournalEntry[]
  journalLines         JournalLine[]
  accountingSetting    AccountingSetting?
  categoryAccountMaps  CategoryAccountMap[]
  documentSequences    DocumentSequence[]
  paymentAllocations   PaymentAllocation[]
  // Additive -- Pengelolaan Utang & Piutang: jejak penagihan pelanggan.
  collectionActivities CollectionActivity[]

  // Additive 22 Okt 2026 -- Rekonsiliasi Bank.
  bankStatements     BankStatement[]
  bankStatementLines BankStatementLine[]
  bankMatchedLines   BankMatchedLine[]

  // Additive 22 Okt 2026 -- Pengeluaran Berjenjang.
  expenseRequests  ExpenseRequest[]
  expenseApprovals ExpenseApproval[]

  // Additive 22 Okt 2026 -- Manajemen Aset & Penyusutan.
  assetCategories  AssetCategory[]
  assets           Asset[]
  assetMaintenance AssetMaintenance[]
  assetTransfers   AssetTransfer[]
  assetImpairments AssetImpairment[]

  auditLogs         AuditLog[]          @relation("WorkspaceAuditLogs")
  backups           Backup[]            @relation("WorkspaceBackups")
  DepreciationEntry DepreciationEntry[]

  // Additive 22 Okt 2026 -- Modul Pajak & Kalender Kepatuhan.
  taxPeriods          TaxPeriod[]
  complianceDeadlines ComplianceDeadline[]
  taxDocuments        TaxDocument[]
  taxWithholdings     TaxWithholding[]
  taxAccountMaps      TaxAccountMap[]

  @@map("workspaces")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

// Functional division identity is intentionally separate from the generic
// workspace permission role above. A Manager division user must not become an
// OWNER/ADMIN merely because the product title contains "Manager".
enum DivisionRole {
  CEO
  FINANCE
  MARKETING
  SEKRETARIS
  MANAGER_UMUM
  MANAGER_OPERASIONAL
}

model WorkspaceMember {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  role         Role          @default(MEMBER)
  divisionRole DivisionRole? @map("division_role")
  joinedAt     DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum PlanType {
  FREE
  STARTED
  BUSINESS
}

enum AccessType {
  KLIR_ALL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @unique @map("workspace_id") @db.Uuid
  planType    PlanType           @map("plan_type")
  accessType  AccessType         @map("access_type")
  startDate   DateTime           @map("start_date")
  endDate     DateTime           @map("end_date")
  status      SubscriptionStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditAccount {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @unique @map("workspace_id") @db.Uuid
  weeklyCredit  Int      @default(0) @map("weekly_credit")
  reserveCredit Int      @default(0) @map("reserve_credit")
  lastReset     DateTime @default(now()) @map("last_reset")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("credit_accounts")
}

enum LedgerType {
  CONSUME
  REFILL
  RESERVE_UNLOCK
}

model CreditLedger {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  amount      Int
  type        LedgerType
  source      String     @db.VarChar(100)
  metadata    Json?      @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("credit_ledger")
}

model WorkspaceAIKey {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  provider    String   @db.VarChar(50)
  apiKeyEnc   String   @map("api_key_enc") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_keys")
}

enum CostType {
  FIXED
  DYNAMIC
}

model FeatureCost {
  id         String   @id @default(uuid()) @db.Uuid
  featureKey String   @unique @map("feature_key") @db.VarChar(100)
  creditCost Int      @map("credit_cost")
  costType   CostType @default(FIXED) @map("cost_type")

  @@map("feature_costs")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// Proyek / unit kerja yang bisa menjadi dimensi laba.
///
/// Sebelum modul Profitabilitas, model ini hanya menyimpan nama & deskripsi.
/// Kolom baru di bawah bersifat additive: baris lama otomatis ACTIVE tanpa
/// divisi, dan laporan menampilkannya sebagai "Tanpa Divisi" sampai ditandai.
model Project {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  name        String        @db.VarChar(255)
  description String?       @db.Text
  code        String?       @db.VarChar(50)
  clientName  String?       @map("client_name") @db.VarChar(150)
  /// Divisi pemilik proyek (nilai dari enum DivisionRole / daftar DIVISIONS).
  division    String?       @db.VarChar(30)
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  createdBy   String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator          User              @relation("ProjectCreator", fields: [createdBy], references: [id])
  journalLines     JournalLine[]
  invoices         Invoice[]
  cashTransactions CashTransaction[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, division])
  @@map("projects")
}

enum MemoryScope {
  PERSONAL
  WORKSPACE
}

model MemoryItem {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  scope       MemoryScope @default(PERSONAL)
  content     String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scope])
  @@map("memory_items")
}

model ActivityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  type        String   @db.VarChar(100)
  payload     Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("activity_events")
}

model ResourceGrant {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  grantedBy   String   @map("granted_by") @db.Uuid
  resource    String   @db.VarChar(100)
  action      String   @default("read,write") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("UserResourceGrants", fields: [userId], references: [id], onDelete: Cascade)
  granter   User      @relation("GrantedResourceGrants", fields: [grantedBy], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, resource])
  @@index([workspaceId, userId])
  @@map("resource_grants")
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ============================================================================
// PENGELUARAN BERJENJANG (TIERED EXPENSE APPROVAL) -- Additive 22 Oct 2026
// ============================================================================

enum ExpenseCategory {
  OPERATIONAL
  MARKETING
  TRAVEL
  MEALS
  EQUIPMENT
  SOFTWARE
  TRAINING
  OTHER
}

enum ExpenseRequestStatus {
  DRAFT
  SUBMITTED
  FINANCE_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpenseApprovalStatus {
  PENDING
  SKIPPED
  DECIDED
}

enum ExpenseDecision {
  APPROVED
  REJECTED
}

model ExpenseRequest {
  id            String @id @default(uuid()) @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid
  requesterId   String @map("requester_id") @db.Uuid
  requesterRole Role   @map("requester_role")

  requestNumber String          @unique @map("request_number") @db.VarChar(50)
  title         String          @db.VarChar(200)
  description   String          @db.Text
  category      ExpenseCategory
  totalAmount   Float           @map("total_amount")

  status         ExpenseRequestStatus @default(DRAFT)
  currentLevel   Int                  @default(0) @map("current_level")
  requiredLevels Int                  @default(0) @map("required_levels")

  financeReviewerId String?   @map("finance_reviewer_id") @db.Uuid
  financeReviewedAt DateTime? @map("finance_reviewed_at")
  financeNotes      String?   @map("finance_notes") @db.Text

  receiptUrls String[] @default([]) @map("receipt_urls") @db.Text

  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  rejectedAt  DateTime? @map("rejected_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester       User                 @relation("ExpenseRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  financeReviewer User?                @relation("ExpenseRequestFinanceReviewer", fields: [financeReviewerId], references: [id], onDelete: SetNull)
  items           ExpenseRequestItem[]
  approvals       ExpenseApproval[]

  @@index([workspaceId, status])
  @@index([workspaceId, requesterId])
  @@index([workspaceId, createdAt])
  @@map("expense_requests")
}

model ExpenseRequestItem {
  id               String   @id @default(uuid()) @db.Uuid
  expenseRequestId String   @map("expense_request_id") @db.Uuid
  description      String   @db.VarChar(300)
  quantity         Int      @default(1)
  unitPrice        Float    @map("unit_price")
  totalPrice       Float    @map("total_price")
  accountCode      String?  @map("account_code") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  expenseRequest ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)

  @@map("expense_request_items")
}

model ExpenseApproval {
  id               String                @id @default(uuid()) @db.Uuid
  expenseRequestId String                @map("expense_request_id") @db.Uuid
  level            Int
  requiredRole     Role                  @map("required_role")
  approverId       String?               @map("approver_id") @db.Uuid
  approverRole     Role?                 @map("approver_role")
  status           ExpenseApprovalStatus @default(PENDING)
  decision         ExpenseDecision?
  reason           String?               @db.Text
  decidedAt        DateTime?             @map("decided_at")
  createdAt        DateTime              @default(now()) @map("created_at")

  expenseRequest ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  approver       User?          @relation("ExpenseApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)
  Workspace      Workspace?     @relation(fields: [workspaceId], references: [id])
  workspaceId    String?        @db.Uuid

  @@unique([expenseRequestId, level])
  @@index([expenseRequestId, level])
  @@map("expense_approvals")
}

model CashTransaction {
  id                  String          @id @default(uuid()) @db.Uuid
  workspaceId         String          @map("workspace_id") @db.Uuid
  userId              String?         @map("user_id") @db.Uuid
  sourceFileId        String?         @map("source_file_id") @db.Uuid
  // Faktur yang dilunasi transaksi ini (kalau ada). Dipakai jurnal otomatis untuk
  // memilih akun lawan: pelunasan faktur mengurangi PIUTANG, bukan menambah
  // pendapatan lagi -- kalau tidak, pendapatan faktur terhitung dua kali.
  invoiceId           String?         @map("invoice_id") @db.Uuid
  // Kewajiban yang dibayar transaksi ini (kalau ada). Jurnalnya melunasi UTANG,
  // bukan menambah beban lagi -- bebannya sudah diakui saat kewajiban dicatat.
  obligationId        String?         @map("obligation_id") @db.Uuid
  // Slip gaji yang dibayar transaksi ini (kalau ada). Sama seperti kewajiban:
  // bebannya sudah diakui saat slip dibuat, jadi pembayaran hanya melunasi utang.
  payrollId           String?         @map("payroll_id") @db.Uuid
  // Kalau diisi, baris kas ini MELUNASI liabilitas tersebut (mis. setor PPh 21
  // ke 2-1320 atau BPJS ke 2-1340), bukan menambah beban baru.
  settlementAccountId String?         @map("settlement_account_id") @db.Uuid
  type                TransactionType
  category            String          @db.VarChar(100)
  amount              Float
  description         String
  transactionDate     DateTime        @default(now()) @map("transaction_date")
  paymentMethod       String          @default("TRANSFER_BANK") @map("payment_method") @db.VarChar(50)
  receiptUrl          String?         @map("receipt_url")
  // Additive 22 Okt 2026 -- Modul Pajak. Dipakai untuk PPN Masukan (transaksi
  // beban yang memuat PPN) dan pemetaan jenis pajak lain. Nullable: transaksi
  // lama dan transaksi tanpa pajak tetap valid apa adanya.
  taxType             TaxType?        @map("tax_type")
  dpp                 Float?
  taxRate             Float?          @map("tax_rate")
  taxAmount           Float?          @map("tax_amount")
  fakturNumber        String?         @map("faktur_number") @db.VarChar(50)
  /// Divisi yang memakai dana ini. Nullable: kosong = "Tanpa Divisi" (data lama
  /// dan transaksi yang memang tidak terkait divisi). Ikut turun ke
  /// `JournalLine.costCenter` supaya realisasi per divisi berasal dari jurnal.
  division            String?         @db.VarChar(30)
  /// Proyek yang memakai dana ini. Ikut turun ke `JournalLine.projectId` pada
  /// baris pendapatan/beban saja (bukan baris kas).
  projectId           String?         @map("project_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoice            Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  obligation         ScheduledObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  payroll            EmployeePayroll?     @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  settlementAccount  Account?             @relation("CashSettlementAccount", fields: [settlementAccountId], references: [id], onDelete: SetNull)
  project            Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentAllocations PaymentAllocation[]  @relation("CashAllocations")
  bankMatchedLines   BankMatchedLine[]

  @@index([workspaceId, type])
  @@index([workspaceId, transactionDate])
  @@index([workspaceId, sourceFileId])
  @@index([workspaceId, invoiceId])
  @@index([workspaceId, obligationId])
  @@index([workspaceId, payrollId])
  @@index([workspaceId, settlementAccountId])
  @@index([workspaceId, projectId])
  @@map("cash_transactions")
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  // Sudah dibayar sebagian (Fase 3.2). Sisa tagihan = totalAmount - paidAmount.
  PARTIAL
  PAID
  CANCELLED
  OVERDUE
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(50)
  clientName     String        @map("client_name") @db.VarChar(100)
  clientEmail    String?       @map("client_email") @db.VarChar(255)
  clientPhone    String?       @map("client_phone") @db.VarChar(255)
  subtotal       Float
  taxRate        Float         @default(0) @map("tax_rate")
  taxAmount      Float         @default(0) @map("tax_amount")
  // Additive 22 Okt 2026 -- Modul Pajak. `taxType` membedakan PPN (default)
  // dari pungutan lain; `dpp` menyimpan dasar pengenaan saat nilainya berbeda
  // dari subtotal (mis. harga sudah termasuk PPN); `fakturNumber` = nomor
  // faktur pajak/e-Faktur untuk rekonsiliasi.
  taxType        TaxType?      @map("tax_type")
  dpp            Decimal?      @db.Decimal(18, 2)
  fakturNumber   String?       @map("faktur_number") @db.VarChar(50)
  totalAmount    Float         @map("total_amount")
  status         InvoiceStatus @default(UNPAID)
  // Total pelunasan yang sudah dialokasikan (Fase 3.2). Sisa = totalAmount - paidAmount.
  paidAmount     Float         @default(0) @map("paid_amount")
  // Tanggal bisnis faktur (dasar pengakuan pendapatan pada basis akrual).
  // Terpisah dari createdAt supaya staf keuangan bisa mencatat faktur bulan lalu.
  issueDate      DateTime      @default(now()) @map("issue_date")
  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  items          Json          @db.JsonB
  qrisString     String?       @map("qris_string")
  virtualAccount String?       @map("virtual_account") @db.VarChar(50)
  notes          String?
  // Additive -- Pengelolaan Utang & Piutang. `partnerId` menautkan faktur ke
  // master pihak lawan (Partner); dokumen lama tetap null dan dibaca lewat
  // fallback `clientName`. `termDays` menyimpan termin kredit saat faktur dibuat
  // (dueDate sudah diturunkan dari sini). `agingBucket`/`overdueSince` adalah
  // snapshot hasil job penuaan agar daftar jatuh tempo bisa dipercaya tanpa
  // menghitung ulang setiap kali dibuka.
  partnerId      String?       @map("partner_id") @db.Uuid
  termDays       Int?          @map("term_days")
  agingBucket    String?       @map("aging_bucket") @db.VarChar(20)
  overdueSince   DateTime?     @map("overdue_since")
  lastReminderAt DateTime?     @map("last_reminder_at")
  /// Divisi pemilik pendapatan faktur. Dipakai saat posting agar baris
  /// pendapatan membawa `JournalLine.costCenter`. Nullable untuk data lama.
  division       String?       @db.VarChar(30)
  /// Proyek pemilik pendapatan faktur; ikut turun ke `JournalLine.projectId`.
  projectId      String?       @map("project_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  partner              Partner?             @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  project              Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Pelunasan faktur (kalau modul laporan keuangan aktif).
  cashTransactions     CashTransaction[]
  // Alokasi pembayaran per baris kas (pembayaran sebagian & split).
  paymentAllocations   PaymentAllocation[]
  // Riwayat penagihan pelanggan untuk faktur ini.
  collectionActivities CollectionActivity[]

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, partnerId])
  @@index([workspaceId, projectId])
  @@map("invoices")
}

enum DiscountType {
