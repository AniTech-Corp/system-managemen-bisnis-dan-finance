datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.Text
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  memberships      WorkspaceMember[]
  refreshTokens    RefreshToken[]
  creditLedgers    CreditLedger[]
  createdProjects  Project[]         @relation("ProjectCreator")
  memoryItems      MemoryItem[]
  activityEvents   ActivityEvent[]
  resourceGrants   ResourceGrant[]   @relation("UserResourceGrants")
  grantedGrants    ResourceGrant[]   @relation("GrantedResourceGrants")
  cashTransactions CashTransaction[]
  invoices         Invoice[]
  workspaceFiles   WorkspaceFile[]
  stockMovements   StockMovement[]
  purchaseOrders   PurchaseOrder[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Workspace {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  ownerId        String   @map("owner_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  enabledModules String[] @default(["corplan", "personal", "finance", "advertising", "workspace", "schedule", "inventory"]) @map("enabled_modules")

  industry      String? @db.VarChar(100)
  targetMarket  String? @map("target_market") @db.VarChar(150)
  businessModel String? @map("business_model") @db.VarChar(100)

  owner                User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members              WorkspaceMember[]
  subscription         Subscription?
  creditAccount        CreditAccount?
  creditLedgers        CreditLedger[]
  workspaceAIKeys      WorkspaceAIKey[]
  projects             Project[]
  memoryItems          MemoryItem[]
  activityEvents       ActivityEvent[]
  resourceGrants       ResourceGrant[]
  cashTransactions     CashTransaction[]
  invoices             Invoice[]
  promoCoupons         PromoCoupon[]
  campaigns            Campaign[]
  scheduledObligations ScheduledObligation[]
  workspaceFiles       WorkspaceFile[]
  ingestLogs           IngestLog[]
  contentCalendars     ContentCalendar[]
  workTasks            WorkTask[]
  attendanceRecords    AttendanceRecord[]
  employeePayrolls     EmployeePayroll[]
  bookingReservations  BookingReservation[]
  queueTickets         QueueTicket[]
  videoJobs            VideoJob[]
  products             Product[]
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]
  stockReturns         StockReturn[]
  supplierScores       SupplierScore[]
  // Additive 10 Sep 2026 (Fable) -- Modul 7 batch BANGUN F3b/F4, kontrak
  // inventory-api-schema. Lihat komentar model ProductBatch/Customer di bawah.
  productBatches       ProductBatch[]
  customers            Customer[]

  // Additive 19 Okt 2026 -- Modul Laporan Keuangan (double-entry).
  // Tabel baru murni tambahan; CashTransaction tetap ada sebagai dokumen sumber.
  accounts            Account[]
  cashAccounts        CashAccount[]
  partners            Partner[]
  fiscalPeriods       FiscalPeriod[]
  journalEntries      JournalEntry[]
  journalLines        JournalLine[]
  accountingSetting   AccountingSetting?
  categoryAccountMaps CategoryAccountMap[]
  documentSequences   DocumentSequence[]

  @@map("workspaces")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

// Functional division identity is intentionally separate from the generic
// workspace permission role above. A Manager division user must not become an
// OWNER/ADMIN merely because the product title contains "Manager".
enum DivisionRole {
  CEO
  FINANCE
  MARKETING
  SEKRETARIS
  MANAGER_UMUM
  MANAGER_OPERASIONAL
}

model WorkspaceMember {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  role         Role          @default(MEMBER)
  divisionRole DivisionRole? @map("division_role")
  joinedAt     DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum PlanType {
  FREE
  STARTED
  BUSINESS
}

enum AccessType {
  KLIR_ALL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @unique @map("workspace_id") @db.Uuid
  planType    PlanType           @map("plan_type")
  accessType  AccessType         @map("access_type")
  startDate   DateTime           @map("start_date")
  endDate     DateTime           @map("end_date")
  status      SubscriptionStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditAccount {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @unique @map("workspace_id") @db.Uuid
  weeklyCredit  Int      @default(0) @map("weekly_credit")
  reserveCredit Int      @default(0) @map("reserve_credit")
  lastReset     DateTime @default(now()) @map("last_reset")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("credit_accounts")
}

enum LedgerType {
  CONSUME
  REFILL
  RESERVE_UNLOCK
}

model CreditLedger {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  amount      Int
  type        LedgerType
  source      String     @db.VarChar(100)
  metadata    Json?      @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("credit_ledger")
}

model WorkspaceAIKey {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  provider    String   @db.VarChar(50)
  apiKeyEnc   String   @map("api_key_enc") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_keys")
}

enum CostType {
  FIXED
  DYNAMIC
}

model FeatureCost {
  id         String   @id @default(uuid()) @db.Uuid
  featureKey String   @unique @map("feature_key") @db.VarChar(100)
  creditCost Int      @map("credit_cost")
  costType   CostType @default(FIXED) @map("cost_type")

  @@map("feature_costs")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("ProjectCreator", fields: [createdBy], references: [id])

  @@index([workspaceId])
  @@map("projects")
}

enum MemoryScope {
  PERSONAL
  WORKSPACE
}

model MemoryItem {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  scope       MemoryScope @default(PERSONAL)
  content     String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scope])
  @@map("memory_items")
}

model ActivityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  type        String   @db.VarChar(100)
  payload     Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("activity_events")
}

model ResourceGrant {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  grantedBy   String   @map("granted_by") @db.Uuid
  resource    String   @db.VarChar(100)
  action      String   @default("read,write") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("UserResourceGrants", fields: [userId], references: [id], onDelete: Cascade)
  granter   User      @relation("GrantedResourceGrants", fields: [grantedBy], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, resource])
  @@index([workspaceId, userId])
  @@map("resource_grants")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model CashTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  userId          String?         @map("user_id") @db.Uuid
  sourceFileId    String?         @map("source_file_id") @db.Uuid
  // Faktur yang dilunasi transaksi ini (kalau ada). Dipakai jurnal otomatis untuk
  // memilih akun lawan: pelunasan faktur mengurangi PIUTANG, bukan menambah
  // pendapatan lagi -- kalau tidak, pendapatan faktur terhitung dua kali.
  invoiceId       String?         @map("invoice_id") @db.Uuid
  // Kewajiban yang dibayar transaksi ini (kalau ada). Jurnalnya melunasi UTANG,
  // bukan menambah beban lagi -- bebannya sudah diakui saat kewajiban dicatat.
  obligationId    String?         @map("obligation_id") @db.Uuid
  type            TransactionType
  category        String          @db.VarChar(100)
  amount          Float
  description     String
  transactionDate DateTime        @default(now()) @map("transaction_date")
  paymentMethod   String          @default("TRANSFER_BANK") @map("payment_method") @db.VarChar(50)
  receiptUrl      String?         @map("receipt_url")
  createdAt       DateTime        @default(now()) @map("created_at")

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoice    Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  obligation ScheduledObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type])
  @@index([workspaceId, transactionDate])
  @@index([workspaceId, sourceFileId])
  @@index([workspaceId, invoiceId])
  @@index([workspaceId, obligationId])
  @@map("cash_transactions")
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  CANCELLED
  OVERDUE
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(50)
  clientName     String        @map("client_name") @db.VarChar(100)
  clientEmail    String?       @map("client_email") @db.VarChar(255)
  clientPhone    String?       @map("client_phone") @db.VarChar(255)
  subtotal       Float
  taxRate        Float         @default(0) @map("tax_rate")
  taxAmount      Float         @default(0) @map("tax_amount")
  totalAmount    Float         @map("total_amount")
  status         InvoiceStatus @default(UNPAID)
  // Tanggal bisnis faktur (dasar pengakuan pendapatan pada basis akrual).
  // Terpisah dari createdAt supaya staf keuangan bisa mencatat faktur bulan lalu.
  issueDate      DateTime      @default(now()) @map("issue_date")
  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  items          Json          @db.JsonB
  qrisString     String?       @map("qris_string")
  virtualAccount String?       @map("virtual_account") @db.VarChar(50)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Pelunasan faktur (kalau modul laporan keuangan aktif).
  cashTransactions CashTransaction[]

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@map("invoices")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromoCoupon {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  code          String       @db.VarChar(50)
  discountType  DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Float        @map("discount_value")
  minPurchase   Float        @default(0) @map("min_purchase")
  maxDiscount   Float?       @map("max_discount")
  quota         Int          @default(100)
  usedCount     Int          @default(0) @map("used_count")
  validUntil    DateTime     @map("valid_until")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive])
  @@map("promo_coupons")
}

// Roadmap 7 Sep, item 4.7 -- MarketingModuleView.tsx punya UI kampanye iklan
// (dailyBudget/roas/platform/leads/status) tapi backend-nya belum pernah ada
// sama sekali (dikonfirmasi lewat full-scan schema.prisma, 0 match). Model
// baru murni aditif, tidak mengubah PromoCoupon atau model lain manapun.
enum CampaignPlatform {
  META_ADS
  TIKTOK_ADS
  GOOGLE_ADS
  LAINNYA
}

enum CampaignStatus {
  ACTIVE
  PAUSED
}

model Campaign {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  name        String           @db.VarChar(150)
  platform    CampaignPlatform @default(LAINNYA)
  dailyBudget Float            @map("daily_budget")
  roas        Float?
  leads       Int              @default(0)
  status      CampaignStatus   @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("campaigns")
}

// Roadmap 7 Sep, item 4.8 -- FinanceModuleView.tsx punya widget "Kewajiban
// terjadwal" tapi upcomingDues14/30 hardcode array kosong (bukan state, tidak
// pernah fetch). Model Invoice yang ada adalah PIUTANG (uang masuk), model ini
// untuk KEWAJIBAN (uang keluar terjadwal) -- konsep beda, tabel terpisah.
enum ObligationStatus {
  PENDING
  PAID
  CANCELLED
}

model ScheduledObligation {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  name          String           @db.VarChar(150)
  dueDate       DateTime         @map("due_date")
  amount        Float
  status        ObligationStatus @default(PENDING)
  category      String?          @db.VarChar(100)
  // Tanggal & metode pembayaran saat kewajiban dilunasi.
  paidAt        DateTime?        @map("paid_at")
  paymentMethod String?          @map("payment_method") @db.VarChar(50)
  createdAt     DateTime         @default(now()) @map("created_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cashTransactions CashTransaction[]

  @@index([workspaceId, dueDate])
  @@index([workspaceId, status])
  @@map("scheduled_obligations")
}

// Roadmap 7 Sep, item 4.2/4.1 -- fondasi penyimpanan file (Pusat/Hub Upload Data,
// prioritas #1 versi Mecca). Dicek langsung ke skema sebelum menulis ini: TIDAK ADA
// model File/Upload/Attachment/Document manapun -- upload sekarang (extract-text,
// analyze) proses-lalu-buang, nol penyimpanan. Model ini murni aditif, tidak
// mengubah model/kolom existing manapun. MVP: simpan file sebagai Bytes langsung
// di Postgres (Neon yang sudah dipakai), BUKAN object storage baru -- nol
// infrastruktur tambahan, konsisten filosofi aditif-minimal sesi ini. Migrasi ke
// object storage terpisah bisa jadi kerjaan lanjutan kalau skala membesar.
enum WorkspaceFileStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model WorkspaceFile {
  id               String              @id @default(uuid()) @db.Uuid
  workspaceId      String              @map("workspace_id") @db.Uuid
  uploadedBy       String?             @map("uploaded_by") @db.Uuid
  fileName         String              @map("file_name") @db.VarChar(255)
  fileType         String              @map("file_type") @db.VarChar(100)
  category         FileCategory        @default(UMUM)
  contentHash      String?             @map("content_hash") @db.VarChar(64)
  sizeBytes        Int                 @map("size_bytes")
  storageBlob      Bytes               @map("storage_blob")
  extractedSummary String?             @map("extracted_summary")
  // Id record turunan (mis. CashTransaction) yang lahir dari file ini -- dipakai
  // Hub Upload buat nunjukin "file ini menghasilkan apa" (Bagian 5 roadmap, poin 2).
  linkedRecordIds  String[]            @default([]) @map("linked_record_ids")
  status           WorkspaceFileStatus @default(PROCESSED)
  createdAt        DateTime            @default(now()) @map("created_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader   User?       @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  ingestLogs IngestLog[]

  @@index([workspaceId, createdAt])
  @@map("workspace_files")
}

enum FileCategory {
  KEUANGAN
  NOTULEN
  KONTRAK
  KATALOG
  UMUM
}

model IngestLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  fileId      String   @map("file_id") @db.Uuid
  kind        String   @db.VarChar(50)
  recordCount Int      @default(0) @map("record_count")
  summary     Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file      WorkspaceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([workspaceId, fileId])
  @@map("ingest_logs")
}

// VideoJob (7 Sep 2026 malam, ditambahkan Claude atas izin eksplisit Mecca -- lihat
// 2026-09-07-untuk-fatur-sesi-lanjutan-perubahan-baru.md Bagian 6). Alasan: render
// video di provider (OpenRouter) berjalan asinkron; job id provider sebelumnya TIDAK
// dipetakan ke workspace mana pun, sehingga (a) anggota workspace lain yang tahu id
// bisa menonton/mengunduh video tenant lain lewat /api/v1/media/video-content, dan
// (b) job yang sedang render hilang dari jejak kalau tab ditutup. Tabel ini murni
// ADDITIVE (tidak mengubah kolom/tabel lama), disinkronkan dengan `prisma db push`
// (pola yang sama dengan WorkspaceFile/Campaign hari yang sama). Rollback: hapus
// model+enum ini lalu `prisma db push` lagi (tabel `video_jobs` di-drop).
enum VideoJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

model VideoJob {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  userId        String?        @map("user_id") @db.Uuid
  provider      String         @default("openrouter") @db.VarChar(50)
  providerJobId String         @unique @map("provider_job_id") @db.VarChar(120)
  model         String         @db.VarChar(200)
  prompt        String         @db.Text
  status        VideoJobStatus @default(PENDING)
  // URL proxy same-origin KLIR (bukan URL provider) saat COMPLETED; null selain itu.
  contentUrl    String?        @map("content_url")
  costUsd       Float?         @map("cost_usd")
  error         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  completedAt   DateTime?      @map("completed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("video_jobs")
}

model ContentCalendar {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  title       String   @db.VarChar(100)
  planData    Json     @map("plan_data") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("content_calendars")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model WorkTask {
  id           String       @id @default(uuid()) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  sourceFileId String?      @map("source_file_id") @db.Uuid
  title        String       @db.VarChar(200)
  description  String?
  assigneeName String       @default("Tim Operasional") @map("assignee_name") @db.VarChar(100)
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  dueDate      DateTime?    @map("due_date")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, sourceFileId])
  @@map("work_tasks")
}

enum AttendanceStatus {
  HADIR_TEPAT_WAKTU
  TERLAMBAT
  IZIN
  CUTI
}

model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  employeeName String           @map("employee_name") @db.VarChar(100)
