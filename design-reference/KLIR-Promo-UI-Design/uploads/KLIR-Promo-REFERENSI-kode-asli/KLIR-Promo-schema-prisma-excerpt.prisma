// Potongan model Prisma yang relevan, disertakan sebagai referensi struktur data (field apa yang ada),
// BUKAN untuk didesain field-per-field secara literal di UI.

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model PromoCoupon {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  code          String       @db.VarChar(50)
  discountType  DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Float        @map("discount_value")
  minPurchase   Float        @default(0) @map("min_purchase")
  maxDiscount   Float?       @map("max_discount")
  quota         Int          @default(100)
  usedCount     Int          @default(0) @map("used_count")
  validUntil    DateTime     @map("valid_until")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive])
  @@map("promo_coupons")
}

model ContentCalendar {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  title       String   @db.VarChar(100)
  planData    Json     @map("plan_data") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("content_calendars")
}

