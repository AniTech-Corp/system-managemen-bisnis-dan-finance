datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(255)
  avatarUrl     String?   @map("avatar_url") @db.Text
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  memberships       WorkspaceMember[]
  refreshTokens     RefreshToken[]
  creditLedgers     CreditLedger[]
  createdProjects   Project[]         @relation("ProjectCreator")
  memoryItems       MemoryItem[]
  activityEvents    ActivityEvent[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime @map("expires_at")
  isRevoked   Boolean  @default(false) @map("is_revoked")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  ownerId     String   @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner             User               @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members           WorkspaceMember[]
  subscription      Subscription?
  creditAccount     CreditAccount?
  creditLedgers     CreditLedger[]
  workspaceAIKey    WorkspaceAIKey?
  projects          Project[]
  memoryItems       MemoryItem[]
  activityEvents    ActivityEvent[]
  onboardingProfile OnboardingProfile?
  corplanProjects   CorPlanProject[]
  anivirtualSessions AniVirtualSession[]
  workflows         Workflow[]

  @@map("workspaces")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model WorkspaceMember {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now()) @map("joined_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum PlanType {
  FREE
  STARTED
  BUSINESS
}

enum AccessType {
  KLIR_ALL
  CORPLAN_ONLY
  ANIVIRTUAL_ONLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @unique @map("workspace_id") @db.Uuid
  planType    PlanType           @map("plan_type")
  accessType  AccessType         @map("access_type")
  startDate   DateTime           @map("start_date")
  endDate     DateTime           @map("end_date")
  status      SubscriptionStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model CreditAccount {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @unique @map("workspace_id") @db.Uuid
  weeklyCredit  Int       @default(0) @map("weekly_credit")
  reserveCredit Int       @default(0) @map("reserve_credit")
  lastReset     DateTime  @default(now()) @map("last_reset")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("credit_accounts")
}

enum LedgerType {
  CONSUME
  REFILL
  RESERVE_UNLOCK
}

model CreditLedger {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  amount      Int
  type        LedgerType
  source      String     @db.VarChar(100)
  metadata    Json?      @db.JsonB
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("credit_ledger")
}

model WorkspaceAIKey {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  provider    String   @db.VarChar(50)
  apiKeyEnc   String   @map("api_key_enc") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_keys")
}

model Entitlement {
  id         String     @id @default(uuid()) @db.Uuid
  planType   PlanType   @map("plan_type")
  accessType AccessType @map("access_type")
  featureKey String     @map("feature_key") @db.VarChar(100)
  allowed    Boolean    @default(true)

  @@unique([planType, accessType, featureKey])
  @@map("entitlements")
}

enum CostType {
  FIXED
  DYNAMIC
}

model FeatureCost {
  id         String   @id @default(uuid()) @db.Uuid
  featureKey String   @unique @map("feature_key") @db.VarChar(100)
  creditCost Int      @map("credit_cost")
  costType   CostType @default(FIXED) @map("cost_type")

  @@map("feature_costs")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator         User             @relation("ProjectCreator", fields: [createdBy], references: [id])
  contextItems    ContextItem[]
  corplanProjects CorPlanProject[]

  @@index([workspaceId])
  @@map("projects")
}

model ContextItem {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  type      String   @db.VarChar(50)
  content   String   @db.Text
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("context_items")
}

enum MemoryScope {
  PERSONAL
  WORKSPACE
}

model MemoryItem {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  scope       MemoryScope @default(PERSONAL)
  content     String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scope])
  @@map("memory_items")
}

model ActivityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  type        String   @db.VarChar(100)
  payload     Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("activity_events")
}

model OnboardingProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @unique @map("workspace_id") @db.Uuid
  primaryNeed         String   @map("primary_need") @db.VarChar(100)
  recommendedFeatures Json     @map("recommended_features") @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at")

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("onboarding_profiles")
}

model CorPlanProject {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  title       String   @db.VarChar(255)
  revisionSeq Int      @default(1) @map("revision_seq")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  outputs     CorPlanOutput[]

  @@index([workspaceId])
  @@map("corplan_projects")
}

model CorPlanOutput {
  id              String         @id @default(uuid()) @db.Uuid
  corplanProjectId String        @map("corplan_project_id") @db.Uuid
  module          String         @db.VarChar(50)
  outputData      Json           @map("output_data") @db.JsonB
  createdAt       DateTime       @default(now()) @map("created_at")

  corplanProject  CorPlanProject @relation(fields: [corplanProjectId], references: [id], onDelete: Cascade)

  @@index([corplanProjectId, module])
  @@map("corplan_outputs")
}

enum SessionType {
  UNDERSTAND
  REPLY
  REQUEST
  ROADMAP
}

model AniVirtualSession {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  type        SessionType
  title       String?            @db.VarChar(255)
  createdAt   DateTime           @default(now()) @map("created_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    AniVirtualMessage[]

  @@index([workspaceId, userId])
  @@map("anivirtual_sessions")
}

model AniVirtualMessage {
  id        String            @id @default(uuid()) @db.Uuid
  sessionId String            @map("session_id") @db.Uuid
  sender    String            @db.VarChar(20)
  content   Json              @db.JsonB
  createdAt DateTime          @default(now()) @map("created_at")

  session   AniVirtualSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("anivirtual_messages")
}

enum WorkflowStatus {
  ACTIVE
  PAUSED
}

model Workflow {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  triggerSource String         @map("trigger_source") @db.VarChar(100)
  actionTarget  String         @map("action_target") @db.VarChar(100)
  config        Json?          @db.JsonB
  status        WorkflowStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs          WorkflowLog[]

  @@index([workspaceId])
  @@map("workflows")
}

model WorkflowLog {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @map("workflow_id") @db.Uuid
  status     String   @db.VarChar(50)
  payload    Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_logs")
}
